---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Brandon Moore — Designer">
  <!-- Hero -->
  <section
    class="max-w-5xl mx-auto px-6 pt-24 pb-20 min-h-screen flex flex-col justify-center"
  >
    <h1
      class="font-mono font-medium text-primary/95 text-6xl sm:text-7xl lg:text-8xl leading-[1.05] tracking-tight lowercase"
    >
      <span class="block rise-el" style="--rise-delay: 0ms">hi.</span>
      <span class="block rise-el" style="--rise-delay: 100ms">i'm</span>
      <span class="block rise-el" style="--rise-delay: 200ms">brandon.</span>
    </h1>
    <p
      class="font-mono text-base sm:text-lg text-primary/70 leading-relaxed mt-10 max-w-xl rise-el"
      style="--rise-delay: 380ms"
    >
      Product designer at Microsoft, currently shaping Power BI. I've spent the
      last few years thinking about data models, developer experiences, and AI.
    </p>
  </section>

  <!-- Empty-state placeholder for current work -->
  <section class="max-w-5xl mx-auto px-6 pb-12">
    <aside
      class="empty-state relative rounded-3xl bg-transparent p-8 sm:p-10 text-center"
      aria-label="No current work to show"
    >
      <svg
        class="empty-state-border absolute inset-0 w-full h-full pointer-events-none"
        aria-hidden="true"
        preserveAspectRatio="none"
      >
        <rect
          x="1.5"
          y="1.5"
          width="100%"
          height="100%"
          rx="22.5"
          ry="22.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-dasharray="14 16"
          vector-effect="non-scaling-stroke"
          style="width: calc(100% - 3px); height: calc(100% - 3px);"
        ></rect>
      </svg>
      <p
        class="relative font-mono text-xs uppercase tracking-[0.18em] text-primary/40 mb-3"
      >
        No recent work to show
      </p>
      <p
        class="relative font-mono text-sm sm:text-base text-primary/55 leading-relaxed max-w-md mx-auto"
      >
        My Power BI work at Microsoft isn't public.
      </p>
    </aside>
  </section>

  <!-- Archive -->
  <section class="max-w-5xl mx-auto px-6 pb-24">
    <details class="archive group">
      <summary
        class="archive-summary list-none cursor-pointer rounded-3xl border border-border/15 p-7 sm:p-9 flex items-center justify-between gap-6 transition-all duration-500 ease-[cubic-bezier(0.345,0.115,0.135,1.42)] hover:bg-border/5 hover:scale-[1.02] active:scale-100"
      >
        <div class="min-w-0">
          <p
            class="font-mono text-xs uppercase tracking-[0.18em] text-primary/50 mb-2"
          >
            Archive
          </p>
          <h2
            class="font-display font-bold text-xl sm:text-2xl text-primary/90"
          >
            Earlier case studies
          </h2>
          <p class="mt-1 text-sm text-primary/60 max-w-xl">
            Three projects from my CBORD &amp; Horizon Software years
            (2018&ndash;2020). Older work — kept here for context, not as a
            reflection of my current practice.
          </p>
        </div>
        <svg
          class="archive-chevron w-5 h-5 shrink-0 text-primary/50 transition-transform duration-300"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </summary>

      <div class="archive-content space-y-4 pt-4">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              shortDesc={project.data.shortDesc}
              slug={project.id}
              thumbnail={project.data.thumbnail}
              variant="compact"
            />
          ))
        }
      </div>
    </details>
  </section>
</BaseLayout>

<style>
  /* Inline SVG dashed border — true rounded caps. Uses currentColor so it
     follows the theme via the parent's text color. */
  .empty-state {
    color: color-mix(in srgb, var(--color-primary) 22%, transparent);
  }
  .empty-state-border {
    overflow: visible;
  }

  /* Hide the default disclosure marker across browsers */
  .archive-summary::-webkit-details-marker {
    display: none;
  }
  .archive[open] .archive-chevron {
    transform: rotate(180deg);
  }

  /* Reveal the 3 project cards with a soft cascade when the disclosure opens.
     Uses CSS-only entrance animations — keeps the markup clean and matches the
     `rise-el` family used elsewhere on the site. */
  .archive[open] .archive-content > * {
    opacity: 0;
    transform: translateY(8px);
    animation: archive-rise 480ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .archive[open] .archive-content > *:nth-child(1) {
    animation-delay: 60ms;
  }
  .archive[open] .archive-content > *:nth-child(2) {
    animation-delay: 140ms;
  }
  .archive[open] .archive-content > *:nth-child(3) {
    animation-delay: 220ms;
  }
  @keyframes archive-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .archive[open] .archive-content > * {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .archive-chevron {
      transition: none;
    }
  }
</style>
