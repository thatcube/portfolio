---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Brandon Moore — Designer">
  <!-- Hero -->
  <section
    class="max-w-5xl mx-auto px-6 pt-24 pb-20 min-h-screen flex flex-col justify-center"
  >
    <h1
      class="font-mono font-medium text-primary/95 text-6xl sm:text-7xl lg:text-8xl leading-[1.05] tracking-tight lowercase"
    >
      <span class="block rise-el" style="--rise-delay: 0ms">hi.</span>
      <span class="block rise-el" style="--rise-delay: 100ms">i'm</span>
      <span class="block rise-el" style="--rise-delay: 200ms">brandon.</span>
    </h1>
    <p
      class="font-mono text-base sm:text-lg text-primary/70 leading-relaxed mt-10 max-w-xl rise-el"
      style="--rise-delay: 380ms"
    >
      Product designer at Microsoft. I shape Power BI's data modeling,
      developer, and AI experiences.
    </p>
  </section>

  <!-- Empty-state placeholder for current work -->
  <section class="max-w-5xl mx-auto px-6 pb-12">
    <aside
      class="empty-state relative rounded-3xl bg-transparent py-12 px-8 sm:py-14 sm:px-10 text-center"
      aria-label="No current work to show"
    >
      <svg
        class="empty-state-border absolute inset-0 w-full h-full pointer-events-none"
        aria-hidden="true"
        preserveAspectRatio="none"
      >
        <rect
          x="1.5"
          y="1.5"
          width="100%"
          height="100%"
          rx="22.5"
          ry="22.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-dasharray="14 16"
          vector-effect="non-scaling-stroke"
          style="width: calc(100% - 3px); height: calc(100% - 3px);"></rect>
      </svg>
      <p
        class="relative font-mono text-xs uppercase tracking-[0.18em] text-primary/40 mb-3"
      >
        No recent work to show
      </p>
      <p
        class="relative font-mono text-sm sm:text-base text-primary/70 leading-relaxed max-w-md mx-auto"
      >
        My work at Microsoft isn't public.
      </p>
    </aside>
  </section>

  <!-- Archive -->
  <section class="max-w-5xl mx-auto px-6 pb-24">
    <details
      class="archive group rounded-3xl border border-border/15 overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.345,0.115,0.135,1.42)]"
    >
      <summary
        class="archive-summary list-none cursor-pointer py-12 px-8 sm:py-14 sm:px-10 flex items-center justify-between gap-6 transition-colors duration-300 hover:bg-border/[0.04]"
      >
        <div class="min-w-0">
          <p
            class="font-mono text-xs uppercase tracking-[0.18em] text-primary/40 mb-3"
          >
            Earlier work
          </p>
          <p class="font-mono text-sm sm:text-base text-primary/70 leading-relaxed">
            Projects from CBORD (now Illumia) and Horizon Software,
            2018&ndash;2021.
          </p>
        </div>
        <svg
          class="archive-chevron w-5 h-5 shrink-0 text-primary/50 transition-transform duration-300"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </summary>

      <div class="archive-content">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              shortDesc={project.data.shortDesc}
              slug={project.id}
              thumbnail={project.data.thumbnail}
              variant="nested"
            />
          ))
        }
      </div>
    </details>
  </section>
</BaseLayout>

<style>
  /* Inline SVG dashed border — true rounded caps. Uses currentColor so it
     follows the theme via the parent's text color. */
  .empty-state {
    color: color-mix(in srgb, var(--color-primary) 22%, transparent);
  }
  .empty-state-border {
    overflow: visible;
  }

  /* Hide the default disclosure marker across browsers */
  .archive-summary::-webkit-details-marker {
    display: none;
  }

  /* Whole container lifts on hover only when collapsed — when open, the
     summary is just the header of a larger container, so scaling it would
     feel wrong. */
  .archive:not([open]) {
    transform: scale(1);
  }
  .archive:not([open]):hover {
    transform: scale(1.02);
  }
  .archive:not([open]):active {
    transform: scale(1);
  }

  .archive[open] .archive-chevron {
    transform: rotate(180deg);
  }

  /* Content is clipped during the JS-driven height animation. */
  .archive-content {
    overflow: hidden;
  }

  /* Hairline dividers between summary and rows, and between rows.
     `:global()` is required because `.archive-row` is rendered by the
     ProjectCard component and lives in a different style scope. */
  .archive-content > :global(.archive-row) {
    border-top: 1px solid
      color-mix(in srgb, var(--color-border) 12%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-chevron,
    .archive:not([open]):hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  // Animated <details> open/close using the Web Animations API. CSS-only
  // approaches (`::details-content` + `interpolate-size`) don't have broad
  // enough browser support yet, so we drive it from JS. Re-binds on every
  // `astro:page-load` because ClientRouter swaps the DOM on navigation.
  function initArchive() {
    const details =
      document.querySelector<HTMLDetailsElement>("details.archive");
    if (!details) return;

    const summary = details.querySelector<HTMLElement>(".archive-summary");
    const content = details.querySelector<HTMLElement>(".archive-content");
    if (!summary || !content) return;

    // Avoid double-binding if this script runs twice for the same DOM.
    if (details.dataset.animatedReady === "1") return;
    details.dataset.animatedReady = "1";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let animation: Animation | null = null;
    let isClosing = false;
    let isOpening = false;

    const easeOpen = "cubic-bezier(0.16, 1, 0.3, 1)";
    const easeClose = "cubic-bezier(0.7, 0, 0.84, 0)";

    function open() {
      // Set [open] so the content is laid out, then animate from 0 → height.
      details!.open = true;
      const height = content!.scrollHeight;

      if (reduceMotion.matches) return;

      isOpening = true;
      animation?.cancel();
      animation = content!.animate(
        [
          { height: "0px", opacity: 0 },
          { height: `${height}px`, opacity: 1 },
        ],
        { duration: 480, easing: easeOpen },
      );
      animation.onfinish = () => {
        isOpening = false;
        animation = null;
      };
      animation.oncancel = () => {
        isOpening = false;
      };
    }

    function close() {
      if (reduceMotion.matches) {
        details!.open = false;
        return;
      }

      const height = content!.scrollHeight;
      isClosing = true;
      animation?.cancel();
      animation = content!.animate(
        [
          { height: `${height}px`, opacity: 1 },
          { height: "0px", opacity: 0 },
        ],
        { duration: 320, easing: easeClose },
      );
      animation.onfinish = () => {
        details!.open = false;
        isClosing = false;
        animation = null;
      };
      animation.oncancel = () => {
        isClosing = false;
      };
    }

    summary.addEventListener("click", (e) => {
      e.preventDefault();
      if (isClosing || !details.open) {
        open();
      } else if (isOpening || details.open) {
        close();
      }
    });

    // Keyboard support: <summary> natively toggles on Enter/Space, but
    // because we preventDefault on click, we also need to handle the
    // keydown that produces a click. The browser fires a `click` event
    // for both, so the click handler above already covers it.
  }

  document.addEventListener("astro:page-load", initArchive);
</script>
