---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Page not found">
  <section class="max-w-3xl mx-auto px-6 pt-20 pb-32 text-center">
    <div class="mx-auto w-24 mb-4">
      <svg
        viewBox="0 0 200 220"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-auto"
        role="img"
        aria-label="A cute cartoon cat crying"
      >
        <!-- Body / loaf shape (grey) - rounded bottom corners -->
        <path
          d="M40 170
             C 40 110 60 70 100 70
             C 140 70 160 110 160 170
             C 160 182 152 188 140 188
             L 60 188
             C 48 188 40 182 40 170 Z"
          fill="#7a8088"
        />

        <!-- Ears: larger, closer to head, rounded tips -->
        <path
          d="M62 88
             Q 56 60 62 48
             Q 70 42 78 56
             L 96 78 Z"
          fill="#7a8088"
        />
        <path
          d="M138 88
             Q 144 60 138 48
             Q 130 42 122 56
             L 104 78 Z"
          fill="#7a8088"
        />
        <!-- Inner ears -->
        <path
          d="M68 78
             Q 64 60 70 58
             Q 76 60 82 74
             Q 82 78 78 78
             Q 72 80 68 78 Z"
          fill="#f4b9c1"
        />
        <path
          d="M132 78
             Q 136 60 130 58
             Q 124 60 118 74
             Q 118 78 122 78
             Q 128 80 132 78 Z"
          fill="#f4b9c1"
        />

        <!-- White chest/belly bib -->
        <path
          d="M76 130
             C 80 165 90 182 100 182
             C 110 182 120 165 124 130
             C 116 138 108 142 100 142
             C 92 142 84 138 76 130 Z"
          fill="#fafafa"
        />

        <!-- White muzzle -->
        <ellipse cx="100" cy="128" rx="22" ry="16" fill="#fafafa" />

        <!-- Closed squinty crying eyes ( >  < ) -->
        <g
          stroke="#2a2d33"
          stroke-width="3.2"
          stroke-linecap="round"
          fill="none"
        >
          <path d="M72 116 Q 80 108 88 116" />
          <path d="M112 116 Q 120 108 128 116" />
        </g>

        <!-- Tears streaming down -->
        <g fill="#7cc4ff">
          <path
            d="M76 122
               C 74 132 74 144 78 152
               C 82 144 82 132 80 122 Z"
          />
          <path
            d="M124 122
               C 122 132 122 144 126 152
               C 130 144 130 132 128 122 Z"
          />
          <!-- Falling drops -->
          <path
            d="M74 162 C 72 168 72 174 76 176 C 80 174 80 168 78 162 Z"
            opacity="0.9"
          />
          <path
            d="M126 162 C 124 168 124 174 128 176 C 132 174 132 168 130 162 Z"
            opacity="0.9"
          />
          <circle cx="72" cy="186" r="2.4" opacity="0.75" />
          <circle cx="130" cy="186" r="2.4" opacity="0.75" />
        </g>

        <!-- Tiny pink nose -->
        <path
          d="M96 126 L104 126 L100 130 Z"
          fill="#e89aa3"
        />

        <!-- Small wobbly frown -->
        <path
          d="M93 136 Q 96 133 100 135 Q 104 133 107 136"
          stroke="#2a2d33"
          stroke-width="2.2"
          stroke-linecap="round"
          fill="none"
        />

        <!-- Whiskers -->
        <g
          stroke="#2a2d33"
          stroke-width="1.3"
          stroke-linecap="round"
          opacity="0.55"
        >
          <line x1="80" y1="130" x2="62" y2="128" />
          <line x1="80" y1="134" x2="62" y2="138" />
          <line x1="120" y1="130" x2="138" y2="128" />
          <line x1="120" y1="134" x2="138" y2="138" />
        </g>

        <!-- Little front paws peeking -->
        <ellipse cx="78" cy="186" rx="10" ry="6" fill="#fafafa" />
        <ellipse cx="122" cy="186" rx="10" ry="6" fill="#fafafa" />
      </svg>
    </div>

    <p class="text-sm font-medium text-primary/60 mb-2">
      404 — page not found
    </p>
    <h1 class="font-display font-semibold text-2xl sm:text-3xl text-primary/95 mb-6">
      This page ran away.
    </h1>

    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-primary/70 hover:text-primary/90 transition-colors"
    >
      ← Back home
    </a>
  </section>
</BaseLayout>
