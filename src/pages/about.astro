---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/images/portrait.jpg";

const experience = [
  {
    title: "Product Designer, Power BI",
    company: "Microsoft",
    range: "April 2021 — Present",
    current: true,
  },
  {
    title: "Product Designer",
    company: 'CBORD <a href="https://illumiatech.com" target="_blank" rel="noopener noreferrer" class="company-link">(now Illumia)</a> & Horizon Software',
    range: "Dec 2018 — April 2021",
  },
  {
    title: "UI Developer",
    company: 'CBORD <a href="https://illumiatech.com" target="_blank" rel="noopener noreferrer" class="company-link">(now Illumia)</a>',
    range: "May 2018 — Dec 2018",
  },
  {
    title: "Software Development Intern",
    company: 'CBORD <a href="https://illumiatech.com" target="_blank" rel="noopener noreferrer" class="company-link">(now Illumia)</a>',
    range: "Feb 2018 — May 2018",
  },
];

const interests = [
  { label: "Cycling", icon: "🚴" },
  { label: "Hiking", icon: "🥾" },
  { label: "Houseplants", icon: "🌱" },
  { label: "Mechanical keyboards", icon: "⌨️" },
  { label: "Coffee", icon: "☕" },
  { label: "Photography", icon: "📷" },
  { label: "Games", icon: "🎲" },
];
---

<BaseLayout title="About — Brandon Moore">
  <!-- Intro -->
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-20 min-h-[80vh] flex flex-col justify-center">
    <div class="intro-grid">
      <div class="intro-text">
        <h1
          class="font-mono font-medium text-primary/95 text-7xl sm:text-8xl leading-[1.05] tracking-tight lowercase"
        >
          about.
        </h1>

        <div class="prose-block">
          <p>
            I'm Brandon, a product designer on the Power BI team at Microsoft.
            I'm passionate about inclusive design, and probably more
            interested in your loading state than I should be.
          </p>
          <p>
            I started my career as a developer before moving into design, and
            the two never really separated for me. Designing is still my
            craft, but knowing how things get built (and being willing to get
            my hands dirty) shapes how I approach every problem.
          </p>
          <p>
            When I'm not designing, I'm usually building something else: a
            side project, a PC, an over-engineered home setup.
          </p>
        </div>
      </div>

      <aside class="portrait-col">
        <div class="portrait-stack">
          <span class="portrait-shadow-card" aria-hidden="true"></span>
          <div class="portrait-frame">
            <Image
              src={portrait}
              alt="Portrait of Brandon Moore"
              widths={[400, 600, 900]}
              sizes="(min-width: 768px) 320px, 75vw"
              class="portrait-img"
            />
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Section divider -->
  <hr class="section-rule" />

  <!-- Experience -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <div class="section-inner">
      <h2 class="section-heading">Experience</h2>
      <ol class="timeline">
        {
          experience.map((item) => (
            <li class={`timeline-item${item.current ? " is-current" : ""}`}>
              <span class="timeline-dot" aria-hidden="true" />
              <div class="timeline-head">
                <h3 class="font-display font-medium text-xl text-primary/95">
                  {item.title}
                </h3>
                {item.current && <span class="now-badge">Now</span>}
              </div>
              <p class="text-primary/75 mt-1" set:html={item.company}></p>
              <p class="text-sm text-primary/50 mt-1 font-mono tracking-tight">
                {item.range}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Section divider -->
  <hr class="section-rule" />

  <!-- Interests -->
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-32">
    <div class="section-inner">
      <h2 class="section-heading">Off the clock</h2>
      <ul class="interests">
        {
          interests.map((it) => (
            <li class="interest-chip">
              <span class="interest-icon" aria-hidden="true">
                {it.icon}
              </span>
              <span>{it.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Intro layout ─────────────────────────────────────────────────────── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .intro-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }

  .intro-text {
    min-width: 0;
  }

  .section-rule {
    width: calc(100% - 3rem);
    max-width: 64rem;
    margin: 0 auto;
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-border) 12%, transparent);
  }

  /* ── Body prose ───────────────────────────────────────────────────────── */
  .prose-block {
    margin-top: 2.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-primary) 78%, transparent);
    text-wrap: pretty;
    max-width: 36rem;
  }

  /* ── Inline company link (e.g. "CBORD (now Illumia)") ────────────────── */
  .company-link {
    color: color-mix(in srgb, var(--color-primary) 60%, transparent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 25%, transparent);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    transition:
      color 200ms ease,
      text-decoration-color 200ms ease;
  }
  .company-link:hover,
  .company-link:focus-visible {
    color: var(--color-primary);
    text-decoration-color: color-mix(in srgb, var(--color-primary) 60%, transparent);
  }

  /* ── Section inner (caps reading width within max-w-5xl frame) ───────── */
  .section-inner {
    max-width: 42rem;
  }

  /* ── Portrait ─────────────────────────────────────────────────────────── */
  .portrait-col {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .portrait-col {
      /* Drop the portrait down so it sits with the body copy rather than
         competing with the headline. */
      margin-top: 6rem;
    }
  }

  @media (max-width: 767px) {
    .portrait-col {
      order: -1;
      margin-bottom: 0.5rem;
    }
  }

  .portrait-stack {
    position: relative;
    width: 19rem;
    pointer-events: none;
    animation: portrait-enable-hover 0s linear 1620ms forwards;
  }

  @keyframes portrait-enable-hover {
    to {
      pointer-events: auto;
    }
  }

  @media (max-width: 767px) {
    .portrait-stack {
      width: 14rem;
    }
  }

  /* Offset outline card sitting behind the portrait */
  .portrait-shadow-card {
    position: absolute;
    inset: 0;
    border-radius: 2rem;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--color-primary) 18%, transparent);
    transform: translate(1.75rem, 1.5rem) rotate(8deg);
    transition: transform 600ms cubic-bezier(0.345, 0.115, 0.135, 1.42);
    animation: portrait-shadow-settle 1200ms cubic-bezier(0.345, 0.115, 0.135, 1.42) 420ms backwards;
  }

  .portrait-stack:hover .portrait-shadow-card {
    transform: translate(2.1rem, 1.85rem) rotate(10deg);
  }

  /* Portrait frame */
  .portrait-frame {
    position: relative;
    border-radius: 2rem;
    overflow: hidden;
    background: var(--color-img-bg);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-primary) 12%, transparent);
    transform: translate(-1rem, 0) rotate(-4deg);
    transition:
      transform 600ms cubic-bezier(0.345, 0.115, 0.135, 1.42),
      box-shadow 400ms ease;
    animation: portrait-frame-settle 1100ms cubic-bezier(0.345, 0.115, 0.135, 1.42) 220ms backwards;
  }

  .portrait-stack:hover .portrait-frame {
    transform: translate(-1rem, 0) rotate(-3deg) scale(1.015);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-primary) 18%, transparent);
  }

  .portrait-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.02);
    transition: filter 500ms ease;
  }

  .portrait-stack:hover .portrait-img {
    filter: saturate(1.05) contrast(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait-stack {
      pointer-events: auto;
      animation: none;
    }
    .portrait-shadow-card,
    .portrait-frame,
    .portrait-img {
      transition: none;
      animation: none;
    }
  }

  /* Portrait entrance — "deal into place": frame settles into its tilt,
     shadow card slides out from behind it. */
  @keyframes portrait-frame-settle {
    from {
      transform: translate(-1rem, 0) rotate(4deg) scale(0.96);
      opacity: 0;
    }
    to {
      transform: translate(-1rem, 0) rotate(-4deg) scale(1);
      opacity: 1;
    }
  }

  @keyframes portrait-shadow-settle {
    from {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0;
    }
    to {
      transform: translate(1.75rem, 1.5rem) rotate(8deg);
      opacity: 1;
    }
  }

  /* ── Section dividers (the liquid motif) ──────────────────────────────── */
  /* Squiggle component handles its own styling — wrapper sizing via utilities. */

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(34 197 94 / 0.6);
    }
    70% {
      box-shadow: 0 0 0 0.5rem rgb(34 197 94 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(34 197 94 / 0);
    }
  }

  /* ── Section headings ─────────────────────────────────────────────────── */
  .section-heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    color: color-mix(in srgb, var(--color-primary) 92%, transparent);
    margin-bottom: 2.5rem;
  }

  /* ── Timeline ─────────────────────────────────────────────────────────── */
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-item {
    position: relative;
    padding-left: 2.25rem;
    padding-bottom: 2.5rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-primary) 30%, transparent);
    transition:
      background 300ms ease,
      box-shadow 300ms ease,
      transform 300ms ease;
  }

  .timeline-item:hover .timeline-dot {
    background: var(--color-primary);
    transform: scale(1.15);
  }

  .timeline-item.is-current .timeline-dot {
    background: #22c55e;
    box-shadow: 0 0 0 0 rgb(34 197 94 / 0.6);
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .timeline-item:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 0.325rem;
    top: 1.6rem;
    bottom: 0.5rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-primary) 18%, transparent),
      color-mix(in srgb, var(--color-primary) 6%, transparent)
    );
  }

  .timeline-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .now-badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 0.5rem;
    color: #16a34a;
    background: color-mix(in srgb, #22c55e 12%, transparent);
    border: 1px solid color-mix(in srgb, #22c55e 24%, transparent);
  }

  :global(.dark) .now-badge {
    color: #4ade80;
  }

  /* ── Interests ────────────────────────────────────────────────────────── */
  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .interest-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.95rem;
    border-radius: 0.75rem;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--color-primary) 80%, transparent);
    background: color-mix(in srgb, var(--color-primary) 4%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent);
    transition:
      transform 400ms cubic-bezier(0.345, 0.115, 0.135, 1.42),
      background 250ms ease,
      border-color 250ms ease;
  }

  .interest-chip:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--color-primary) 7%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 14%, transparent);
  }

  .interest-icon {
    font-size: 1rem;
    line-height: 1;
  }

  /* ── Reveal-on-scroll ─────────────────────────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 700ms cubic-bezier(0.165, 0.84, 0.44, 1),
      transform 700ms cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-item.is-current .timeline-dot {
      animation: none;
    }
    .title-wave path {
      animation: none;
      stroke-dashoffset: 0;
    }
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .portrait-frame,
    .portrait-shadow-card {
      transform: none;
    }
  }
</style>

<script>
  const targets = document.querySelectorAll<HTMLElement>(
    ".timeline-item, .interest-chip"
  );

  const vh = window.innerHeight;
  const aboveFold: HTMLElement[] = [];
  targets.forEach((el) => {
    if (el.getBoundingClientRect().top < vh) aboveFold.push(el);
  });

  aboveFold.forEach((el, i) => {
    el.classList.add("reveal");
    el.style.transitionDelay = `${i * 60}ms`;
  });

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  aboveFold.forEach((el) => io.observe(el));
</script>
