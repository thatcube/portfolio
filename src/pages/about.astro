---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Brandon Moore">
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-12">
    <h1 class="font-display font-extrabold text-4xl sm:text-5xl text-primary/95 mb-6">
      About
    </h1>
    <p class="text-lg text-primary/75 max-w-2xl leading-relaxed">
      I'm a product designer passionate about crafting inclusive and delightful digital experiences.
      Currently designing at Microsoft, I focus on building products that work for everyone.
    </p>
  </section>

  <!-- Experience -->
  <section class="max-w-5xl mx-auto px-6 pb-24">
    <h2 class="font-display font-bold text-2xl text-primary/90 mb-8">
      Experience
    </h2>
    <div class="space-y-8">
      <div class="border-l-2 border-accent pl-6">
        <h3 class="font-display font-bold text-lg text-primary/90">
          Product Designer
        </h3>
        <p class="text-accent font-medium text-sm">
          Microsoft
        </p>
        <p class="text-sm text-primary/50 mt-1">
          April 2021 &mdash; Present
        </p>
      </div>

      <div class="border-l-2 border-border/10 pl-6">
        <h3 class="font-display font-bold text-lg text-primary/90">
          Product Designer
        </h3>
        <p class="text-primary/65 font-medium text-sm">
          CBORD & Horizon Software
        </p>
        <p class="text-sm text-primary/50 mt-1">
          Dec 2018 &mdash; April 2021
        </p>
      </div>

      <div class="border-l-2 border-border/10 pl-6">
        <h3 class="font-display font-bold text-lg text-primary/90">
          UI Developer
        </h3>
        <p class="text-primary/65 font-medium text-sm">
          CBORD
        </p>
        <p class="text-sm text-primary/50 mt-1">
          May 2018 &mdash; Dec 2018
        </p>
      </div>

      <div class="border-l-2 border-border/10 pl-6">
        <h3 class="font-display font-bold text-lg text-primary/90">
          Software Development Intern
        </h3>
        <p class="text-primary/65 font-medium text-sm">
          CBORD
        </p>
        <p class="text-sm text-primary/50 mt-1">
          Feb 2018 &mdash; May 2018
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
