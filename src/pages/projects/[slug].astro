---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { title, shortDesc, problem, solution, role, heroImage } = project.data;
---

<BaseLayout title={`${title} — Brandon Moore`} description={shortDesc}>
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-12">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm text-primary/60 transition-colors mb-8"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 12H5m7-7l-7 7 7 7" />
      </svg>
      Back to projects
    </a>

    <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-primary/95 mb-4">
      {title}
    </h1>
    <p class="text-lg text-primary/70 max-w-2xl">
      {shortDesc}
    </p>
  </section>

  <!-- Meta: Problem / Solution / Role -->
  {(problem || solution || role) && (
    <section class="max-w-5xl mx-auto px-6 pb-12" aria-label="Project overview">
      <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6 m-0">
        {problem && (
          <div class="p-6 rounded-xl bg-raised border border-border/10">
            <div class="w-9 h-9 rounded-full bg-border/10 flex items-center justify-center mb-5" aria-hidden="true">
              <svg class="w-5 h-5 text-primary/90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9" />
                <circle cx="12" cy="12" r="3" fill="currentColor" stroke="none" />
              </svg>
            </div>
            <dt class="text-xs font-bold uppercase tracking-wider text-primary/90 mb-2">Problem</dt>
            <dd class="text-sm text-primary/75 m-0">{problem}</dd>
          </div>
        )}
        {solution && (
          <div class="p-6 rounded-xl bg-raised border border-border/10">
            <div class="w-9 h-9 rounded-full bg-border/10 flex items-center justify-center mb-5" aria-hidden="true">
              <svg class="w-5 h-5 text-primary/90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <dt class="text-xs font-bold uppercase tracking-wider text-primary/90 mb-2">Solution</dt>
            <dd class="text-sm text-primary/75 m-0">{solution}</dd>
          </div>
        )}
        {role && (
          <div class="p-6 rounded-xl bg-raised border border-border/10">
            <div class="w-9 h-9 rounded-full bg-border/10 flex items-center justify-center mb-5" aria-hidden="true">
              <svg class="w-5 h-5 text-primary/90" fill="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" />
              </svg>
            </div>
            <dt class="text-xs font-bold uppercase tracking-wider text-primary/90 mb-2">My Role</dt>
            <dd class="text-sm text-primary/75 m-0">{role}</dd>
          </div>
        )}
      </dl>
    </section>
  )}

  <!-- Hero Image -->
  <section class="max-w-5xl mx-auto px-6 pb-16">
    <div class="rounded-2xl overflow-hidden bg-img-bg">
      <Image
        src={heroImage}
        alt={`${title} hero image`}
        widths={[800, 1200, 1600]}
        sizes="(max-width: 1024px) 100vw, 1024px"
        class="w-full"
      />
    </div>
  </section>

  <!-- MDX Body Content -->
  <article class="max-w-3xl mx-auto px-6 pb-24 prose prose-lg dark:prose-invert prose-headings:font-display prose-headings:font-bold">
    <Content />
  </article>

  <!-- Prev / Next Navigation -->
  <nav class="max-w-5xl mx-auto px-6 pb-24" aria-label="Project navigation">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <a
        href={`/projects/${prev.id}`}
        class="group block rounded-2xl p-6 bg-raised border border-border/10 transition-all duration-500 ease-[cubic-bezier(0.345,0.115,0.135,1.42)] hover:bg-border/5 hover:scale-[1.02]"
      >
        <p class="text-xs font-medium uppercase tracking-wider text-primary/50 mb-2">Previous</p>
        <h3 class="font-display font-extrabold text-2xl sm:text-3xl text-primary/90 transition-colors mb-5">
          {prev.data.title}
        </h3>
        <div class="rounded-xl overflow-hidden bg-img-bg aspect-[16/9]">
          <Image
            src={prev.data.thumbnail}
            alt={prev.data.title}
            widths={[400, 800]}
            sizes="(max-width: 640px) 100vw, 480px"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </a>
      <a
        href={`/projects/${next.id}`}
        class="group block rounded-2xl p-6 bg-raised border border-border/10 transition-all duration-500 ease-[cubic-bezier(0.345,0.115,0.135,1.42)] hover:bg-border/5 hover:scale-[1.02] sm:text-right"
      >
        <p class="text-xs font-medium uppercase tracking-wider text-primary/50 mb-2">Next</p>
        <h3 class="font-display font-extrabold text-2xl sm:text-3xl text-primary/90 transition-colors mb-5">
          {next.data.title}
        </h3>
        <div class="rounded-xl overflow-hidden bg-img-bg aspect-[16/9]">
          <Image
            src={next.data.thumbnail}
            alt={next.data.title}
            widths={[400, 800]}
            sizes="(max-width: 640px) 100vw, 480px"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </a>
    </div>
  </nav>
</BaseLayout>
