---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, shortDesc, problem, solution, role, heroImage } = project.data;
---

<BaseLayout title={`${title} — Brandon Moore`} description={shortDesc}>
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-12">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm text-primary/60 hover:text-accent transition-colors mb-8"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5m7-7l-7 7 7 7" />
      </svg>
      Back to projects
    </a>

    <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-primary/95 mb-4">
      {title}
    </h1>
    <p class="text-lg text-primary/70 max-w-2xl">
      {shortDesc}
    </p>
  </section>

  <!-- Meta: Problem / Solution / Role -->
  {(problem || solution || role) && (
    <section class="max-w-5xl mx-auto px-6 pb-12">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {problem && (
          <div class="p-5 rounded-xl bg-raised border border-border/10">
            <p class="text-xs font-medium uppercase tracking-wider text-accent mb-2">Problem</p>
            <p class="text-sm text-primary/75">{problem}</p>
          </div>
        )}
        {solution && (
          <div class="p-5 rounded-xl bg-raised border border-border/10">
            <p class="text-xs font-medium uppercase tracking-wider text-accent mb-2">Solution</p>
            <p class="text-sm text-primary/75">{solution}</p>
          </div>
        )}
        {role && (
          <div class="p-5 rounded-xl bg-raised border border-border/10">
            <p class="text-xs font-medium uppercase tracking-wider text-accent mb-2">Role</p>
            <p class="text-sm text-primary/75">{role}</p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Hero Image -->
  <section class="max-w-5xl mx-auto px-6 pb-16">
    <div class="rounded-2xl overflow-hidden bg-img-bg">
      <Image
        src={heroImage}
        alt={`${title} hero image`}
        widths={[800, 1200, 1600]}
        sizes="(max-width: 1024px) 100vw, 1024px"
        class="w-full"
      />
    </div>
  </section>

  <!-- MDX Body Content -->
  <article class="max-w-3xl mx-auto px-6 pb-24 prose prose-lg dark:prose-invert prose-headings:font-display prose-headings:font-bold prose-a:text-accent">
    <Content />
  </article>
</BaseLayout>
