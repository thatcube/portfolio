---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { title, shortDesc, problem, solution, role, heroImage } = project.data;
---

<BaseLayout title={`${title} — Brandon Moore`} description={shortDesc}>
  <!-- Title + description -->
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-12">
    <h1 class="rise-el font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-primary/95 mb-4" style="--rise-delay: 0ms">
      {title}
    </h1>
    <p class="rise-el text-lg text-primary/70 max-w-2xl" style="--rise-delay: 100ms">
      {shortDesc}
    </p>
  </section>

  <!-- Hero Image -->
  <section class="max-w-5xl mx-auto px-6 pb-12">
    <div
      class="rise-el rounded-3xl overflow-hidden border border-border/10"
      style="--rise-delay: 200ms"
    >
      <Image
        src={heroImage}
        alt={`${title} hero image`}
        widths={[800, 1200, 1600]}
        sizes="(max-width: 1024px) 100vw, 1024px"
        class="w-full"
      />
    </div>
  </section>

  <!-- Meta: Problem / Solution / Role -->
  {(problem || solution || role) && (
    <section class="max-w-5xl mx-auto px-6 pb-12" aria-label="Project overview">
      <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6 m-0">
        {problem && (
          <div class="rise-el p-6 rounded-2xl border border-border/10" style="--rise-delay: 320ms">
            <div class="w-9 h-9 rounded-full bg-border/10 flex items-center justify-center mb-5" aria-hidden="true">
              <Icon name="ph:target" class="w-5 h-5 text-primary/90" aria-hidden="true" />
            </div>
            <dt class="text-xs font-bold uppercase tracking-wider text-primary/90 mb-2">Problem</dt>
            <dd class="text-sm text-primary/75 m-0">{problem}</dd>
          </div>
        )}
        {solution && (
          <div class="rise-el p-6 rounded-2xl border border-border/10" style="--rise-delay: 440ms">
            <div class="w-9 h-9 rounded-full bg-border/10 flex items-center justify-center mb-5" aria-hidden="true">
              <Icon name="ph:check" class="w-5 h-5 text-primary/90" aria-hidden="true" />
            </div>
            <dt class="text-xs font-bold uppercase tracking-wider text-primary/90 mb-2">Solution</dt>
            <dd class="text-sm text-primary/75 m-0">{solution}</dd>
          </div>
        )}
        {role && (
          <div class="rise-el p-6 rounded-2xl border border-border/10" style="--rise-delay: 560ms">
            <div class="w-9 h-9 rounded-full bg-border/10 flex items-center justify-center mb-5" aria-hidden="true">
              <Icon name="ph:user-fill" class="w-5 h-5 text-primary/90" aria-hidden="true" />
            </div>
            <dt class="text-xs font-bold uppercase tracking-wider text-primary/90 mb-2">My Role</dt>
            <dd class="text-sm text-primary/75 m-0">{role}</dd>
          </div>
        )}
      </dl>
    </section>
  )}

  <!-- MDX Body Content -->
  <article class="max-w-3xl mx-auto px-6 pb-24 prose prose-lg dark:prose-invert prose-headings:font-display prose-headings:font-bold">
    <Content />
  </article>

  <!-- Prev / Next Navigation — rendered into the Footer's project-nav slot so
       it groups with footer chrome instead of sitting flush with article
       content. Only project pages fill this slot. -->
  <nav slot="project-nav" aria-label="Project navigation">
    <div class="max-w-5xl mx-auto px-6 pt-24 pb-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href={`/${prev.id}`}
        class="group flex items-center gap-5 rounded-2xl p-4 border border-border/10 transition-all duration-500 ease-[cubic-bezier(0.345,0.115,0.135,1.42)] hover:bg-border/5 hover:scale-[1.02] active:scale-100"
      >
        <div class="w-16 h-16 shrink-0 rounded-xl overflow-hidden">
          <Image
            src={prev.data.thumbnail}
            alt={prev.data.title}
            widths={[128, 256]}
            sizes="128px"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="min-w-0">
          <p class="text-xs font-medium uppercase tracking-wider text-primary/50 mb-1">Previous</p>
          <h3 class="font-display font-bold text-base sm:text-lg text-primary/90 truncate m-0">
            {prev.data.title}
          </h3>
        </div>
      </a>
      <a
        href={`/${next.id}`}
        class="group flex items-center gap-5 rounded-2xl p-4 border border-border/10 transition-all duration-500 ease-[cubic-bezier(0.345,0.115,0.135,1.42)] hover:bg-border/5 hover:scale-[1.02] active:scale-100 sm:flex-row-reverse sm:text-right"
      >
        <div class="w-16 h-16 shrink-0 rounded-xl overflow-hidden">
          <Image
            src={next.data.thumbnail}
            alt={next.data.title}
            widths={[128, 256]}
            sizes="128px"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="min-w-0">
          <p class="text-xs font-medium uppercase tracking-wider text-primary/50 mb-1">Next</p>
          <h3 class="font-display font-bold text-base sm:text-lg text-primary/90 truncate m-0">
            {next.data.title}
          </h3>
        </div>
      </a>
    </div>
  </nav>
</BaseLayout>
