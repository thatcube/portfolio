---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Brandon Moore — Product Designer on the Power BI team at Microsoft, crafting the details that make products feel alive." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>

    <ClientRouter />

    <!-- After the first page load completes, mark the document so the
         main rise-in animation doesn't replay on view-transition swaps.
         Also stagger a rise-in across the new page's above-the-fold
         direct children of <main> so transitions feel cohesive. -->
    <script is:inline>
      document.addEventListener("astro:after-swap", function () {
        document.documentElement.classList.add("vt-ready");

        var prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (prefersReduced) return;

        var main = document.getElementById("main-content");
        if (!main) return;

        // Pages with .rise-el handle their own CSS animation — skip vt-rise
        if (main.querySelector(".rise-el")) return;

        // Stagger direct children of <main> for other pages
        var vh = window.innerHeight;
        var i = 0;
        for (var n = 0; n < main.children.length; n++) {
          var el = main.children[n];
          var rect = el.getBoundingClientRect();
          if (rect.top >= vh) break;
          el.style.setProperty("--vt-stagger", i);
          el.classList.add("vt-rise");
          (function (node) {
            node.addEventListener("animationend", function () {
              node.classList.remove("vt-rise");
              node.style.removeProperty("--vt-stagger");
            }, { once: true });
          })(el);
          i++;
        }
      });
    </script>

    <!-- Prevent FOUC for dark mode.
         Idempotent: only adds/removes classes if they're not already in the
         desired state. Avoids a transient "neither class" moment that would
         otherwise trigger CSS color transitions. -->
    <script is:inline>
      (function() {
        var theme = localStorage.getItem("theme") || "system";
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var root = document.documentElement;
        var wantDark = theme === "dark" || (theme === "system" && prefersDark);
        var wantLight = theme === "light";
        var hasDark = root.classList.contains("dark");
        var hasLight = root.classList.contains("light");
        if (wantDark) {
          if (!hasDark) root.classList.add("dark");
          if (hasLight) root.classList.remove("light");
        } else if (wantLight) {
          if (!hasLight) root.classList.add("light");
          if (hasDark) root.classList.remove("dark");
        } else {
          if (hasDark) root.classList.remove("dark");
          if (hasLight) root.classList.remove("light");
        }
      })();
    </script>

    <!-- Preserve theme class across SPA navigation.
         ClientRouter copies attributes from the incoming server-rendered
         <html> onto the live <html> during swap. The server can't know the
         user's theme, so the incoming html has no `dark`/`light` class.
         Without this, the live html briefly loses its class → CSS vars flip
         to light defaults → `transition-colors` on nav links animates from
         black → white. That's the dark-mode flash on every navigation.
         Patching the incoming document BEFORE swap keeps the class set so
         attribute reconciliation is a no-op. -->
    <script is:inline>
      document.addEventListener("astro:before-swap", function (e) {
        var src = document.documentElement.classList;
        var dest = e.newDocument.documentElement.classList;
        if (src.contains("dark")) dest.add("dark");
        if (src.contains("light")) dest.add("light");
      });
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer>
      <slot name="project-nav" slot="project-nav" />
    </Footer>
  </body>
</html>
