---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  shortDesc: string;
  slug: string;
  thumbnail: ImageMetadata;
  variant?: "featured" | "compact" | "nested";
}

const { title, shortDesc, slug, thumbnail, variant = "compact" } = Astro.props;
---

{
  variant === "nested" ? (
    <a
      href={`/${slug}`}
      class="archive-row group flex items-center gap-6 sm:gap-8 px-7 sm:px-9 py-5 transition-colors duration-300 hover:bg-border/[0.04] focus-visible:bg-border/[0.04] outline-none"
    >
      <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded-xl overflow-hidden">
        <Image
          src={thumbnail}
          alt={title}
          widths={[128, 256]}
          sizes="128px"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="min-w-0 flex-1">
        <h3 class="font-display font-bold text-lg sm:text-xl text-primary/90">
          {title}
        </h3>
        <p class="mt-1 text-sm text-primary/60">{shortDesc}</p>
      </div>
      <svg
        class="w-5 h-5 shrink-0 text-primary/30 group-hover:text-primary/70 group-hover:translate-x-0.5 transition-all duration-300"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 5l7 7-7 7"
        />
      </svg>
    </a>
  ) : variant === "featured" ? (
    <a
      href={`/${slug}`}
      class="group block rounded-3xl border border-border/10 p-8 sm:p-12 transition-all duration-500 ease-[cubic-bezier(0.345,0.115,0.135,1.42)] hover:bg-border/5 hover:scale-[1.03] active:scale-100 max-sm:hover:scale-[0.97] max-sm:active:scale-[0.94]"
    >
      <div class="rounded-2xl overflow-hidden">
        <Image
          src={thumbnail}
          alt={title}
          widths={[800, 1200]}
          sizes="(max-width: 640px) 100vw, 880px"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
      <div class="mt-8 pt-8 -mx-8 sm:-mx-12 px-8 sm:px-12 border-t border-border/10">
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-primary/90">
          {title}
        </h2>
        <p class="mt-1 text-base text-primary/60">{shortDesc}</p>
      </div>
    </a>
  ) : (
    <a
      href={`/${slug}`}
      class="group flex items-stretch gap-8 rounded-3xl border border-border/10 p-7 sm:p-10 transition-all duration-500 ease-[cubic-bezier(0.345,0.115,0.135,1.42)] hover:bg-border/5 hover:scale-[1.03] active:scale-100 max-sm:hover:scale-[0.97] max-sm:active:scale-[0.94]"
    >
      <div class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 rounded-2xl overflow-hidden">
        <Image
          src={thumbnail}
          alt={title}
          widths={[128, 256]}
          sizes="128px"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="min-w-0 -my-7 sm:-my-10 py-7 sm:py-10 pl-8 border-l border-border/10 self-stretch flex flex-col justify-center">
        <h2 class="font-display font-bold text-xl sm:text-2xl text-primary/90">
          {title}
        </h2>
        <p class="mt-1 text-sm text-primary/60">{shortDesc}</p>
      </div>
    </a>
  )
}
