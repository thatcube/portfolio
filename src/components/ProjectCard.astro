---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  shortDesc: string;
  slug: string;
  thumbnail: ImageMetadata;
  variant?: "featured" | "compact";
}

const { title, shortDesc, slug, thumbnail, variant = "compact" } = Astro.props;
---

{variant === "featured" ? (
  <a
    href={`/projects/${slug}`}
    class="group block rounded-2xl p-4 -mx-4 transition-all duration-300 ease-out hover:bg-border/5 hover:scale-[1.02]"
  >
    <div class="rounded-xl overflow-hidden bg-img-bg">
      <Image
        src={thumbnail}
        alt={title}
        widths={[800, 1200]}
        sizes="(max-width: 640px) 100vw, 960px"
        class="w-full h-full object-cover"
        loading="eager"
      />
    </div>
    <div class="pt-6">
      <h3 class="font-display font-extrabold text-2xl sm:text-3xl text-primary/90 group-hover:text-accent transition-colors">
        {title}
      </h3>
      <p class="mt-1 text-base text-primary/60">
        {shortDesc}
      </p>
    </div>
  </a>
) : (
  <a
    href={`/projects/${slug}`}
    class="group flex items-center gap-6 rounded-2xl p-4 -mx-4 transition-all duration-300 ease-out hover:bg-border/5 hover:scale-[1.02]"
  >
    <div class="w-24 h-24 sm:w-28 sm:h-28 shrink-0 rounded-xl overflow-hidden bg-img-bg">
      <Image
        src={thumbnail}
        alt={title}
        widths={[128, 256]}
        sizes="128px"
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    <div>
      <h3 class="font-display font-bold text-xl sm:text-2xl text-primary/90 group-hover:text-accent transition-colors">
        {title}
      </h3>
      <p class="mt-1 text-sm text-primary/60">
        {shortDesc}
      </p>
    </div>
  </a>
)}
