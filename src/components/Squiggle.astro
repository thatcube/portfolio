---
// Wavy divider — the "liquid" motif used between sections.
// Variants: 'up' (default) and 'down' (mirrored). Keep low-opacity and
// non-interactive; respects prefers-reduced-motion.
interface Props {
  variant?: "up" | "down";
  class?: string;
}
const { variant = "up", class: className = "" } = Astro.props;

const path =
  variant === "down"
    ? "M0 12 Q 75 22, 150 12 T 300 12 T 450 12 T 600 12 T 750 12 T 900 12 T 1050 12 T 1200 12"
    : "M0 12 Q 75 2, 150 12 T 300 12 T 450 12 T 600 12 T 750 12 T 900 12 T 1050 12 T 1200 12";
---

<div class:list={["squiggle", className]} aria-hidden="true">
  <svg viewBox="0 0 1200 24" preserveAspectRatio="none">
    <path
      d={path}
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
    ></path>
  </svg>
</div>

<style>
  .squiggle {
    color: color-mix(in srgb, var(--color-primary) 18%, transparent);
  }

  .squiggle svg {
    display: block;
    width: 100%;
    height: 1.25rem;
    overflow: visible;
  }

  .squiggle path {
    animation: squiggle-drift 9s ease-in-out infinite alternate;
    transform-origin: center;
  }

  @keyframes squiggle-drift {
    from {
      transform: translateX(-6px);
    }
    to {
      transform: translateX(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .squiggle path {
      animation: none;
    }
  }
</style>
