---
// Always-alive liquid mark, brought back from the original
// portfolio. Click triggers a drain → pause → spring-refill cycle.
// Reduced-motion renders a static half-fill.
---

<span class="liquid-logo" aria-hidden="true" transition:persist="liquid-logo">
  <svg viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg" data-liquid-svg>
    <!-- Masked disc: ring + liquid are one continuous shape, so the inner
         ring edge dissolves into the liquid below the waterline with no
         visible seam. The mask radii (and the visible disc radius) are
         driven by JS each frame, so on hover the ring grows in diameter
         while keeping its 8-unit thickness, and the water fills the larger
         interior naturally. -->
    <defs>
      <mask id="liquid-logo-mask" maskUnits="userSpaceOnUse">
        <circle data-ring-outer cx="22" cy="22" r="20" fill="white"></circle>
        <circle data-ring-inner cx="22" cy="22" r="12" fill="black"></circle>
        <path data-liquid-surface fill="white" d="M10 22 L34 22 L34 34 L10 34 Z"
        ></path>
      </mask>
    </defs>
    <circle
      data-ring-disc
      cx="22"
      cy="22"
      r="20"
      fill="currentColor"
      mask="url(#liquid-logo-mask)"></circle>
    <g data-liquid-droplets fill="currentColor"></g>
  </svg>
</span>

<!--
  CRITICAL: this is a SYNCHRONOUS inline script (is:inline keeps it in place
  and unbundled). It runs immediately, before first paint, so it can rewrite
  the SVG's `r` attributes AND surface path to match a hover state that
  survived a full page reload (the brand link uses data-astro-reload).
  Without this, the hoisted module script below runs AFTER first paint,
  causing a visible small→large "jump" when navigating home from another
  page while hovering the logo. Keep this script tiny and dependency-free.
-->
<script is:inline>
  // Pre-paint hydration: if the cursor was hovering the brand link when the
  // user clicked it (data-astro-reload triggers full reload), restore the
  // expanded ring + filled bowl synchronously, before first paint, so there
  // is no visible "small ring" flash + spring-up on arrival.
  //
  // We use a dedicated hover flag (set/cleared in setHover) instead of
  // elementFromPoint, which is unreliable before layout completes.
  (function () {
    try {
      if (sessionStorage.getItem("liquidLogo:hovered") !== "1") return;
      var svg = document.querySelector("[data-liquid-svg]");
      if (!svg) return;
      var disc = svg.querySelector("[data-ring-disc]");
      var outer = svg.querySelector("[data-ring-outer]");
      var inner = svg.querySelector("[data-ring-inner]");
      var surface = svg.querySelector("[data-liquid-surface]");
      // Match constants in the deferred module: outer 20→23, inner 12→16.
      if (disc) disc.setAttribute("r", "23");
      if (outer) outer.setAttribute("r", "23");
      if (inner) inner.setAttribute("r", "16");
      // Surface path for the expanded bowl (R=16, CY=22, level=0.5).
      // Without this, the water only fills the small bowl while the ring
      // is already big — leaving a visible gap at the bottom on first paint.
      if (surface) {
        surface.setAttribute("d", "M2 22 L42 22 L42 42 L2 42 Z");
      }
      window.__liquidPreHover = true;
    } catch (e) {}
  })();
</script>

<style>
  .liquid-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.55em;
    height: 1.55em;
    flex-shrink: 0;
    line-height: 0;
  }
  .liquid-logo svg {
    display: block;
    width: 100%;
    height: 100%;
    /* Allow droplets to render below the vessel without affecting layout */
    overflow: visible;
    /* Force smooth curve rasterization on lower-DPI displays. Without this,
       browsers may use shape-rendering: auto which snaps small circles to
       pixel grid → jagged edges on 1x monitors. */
    shape-rendering: geometricPrecision;
  }
</style>

<script>
  (function () {
    // The brand link is `data-astro-reload`, so clicking it does a full page
    // reload (not an SPA nav). That means the drain animation is visible on
    // the source page, then on the destination page we kick off a "boot
    // droplet shower" via a sessionStorage flag so the click feels continuous.
    //
    // Other (non-brand) navigations DO use ClientRouter, so the LiquidLogo
    // SVG gets replaced with a fresh DOM node on each SPA nav. We re-init
    // on every `astro:page-load` so the new SVG comes alive.
    const SVG_NS = "http://www.w3.org/2000/svg";
    const BOOT_FLAG_KEY = "liquidLogo:boot";
    const POINTER_KEY = "liquidLogo:pointer";

    // Module-scope reference to the current instance's animation hooks so
    // document/window-level listeners (bound once per session) can talk to
    // whichever SVG is currently mounted.
    let current: {
      start: () => void;
      stop: () => void;
      pumpScroll: (dy: number) => void;
      bootShower: () => void;
      kick: () => void;
      drain: () => void;
      setHover: (active: boolean) => void;
      setTilt: (clientX: number) => void;
      setPressed: (active: boolean) => void;
      reduceMotion: MediaQueryList;
    } | null = null;

    // Last known pointer position, used to re-evaluate hover after SPA nav
    // OR full page reload (the brand link uses data-astro-reload). For
    // reload survival we also mirror it into sessionStorage on every move.
    let lastPointer: { x: number; y: number } | null = null;
    try {
      const stored = sessionStorage.getItem(POINTER_KEY);
      if (stored) lastPointer = JSON.parse(stored);
    } catch {}

    function initLiquidLogo() {
      const svg = document.querySelector<SVGSVGElement>("[data-liquid-svg]");
      if (!svg) {
        console.log("[liquid] no SVG found");
        return;
      }

      if ((svg as any).__liquidInit) {
        let arriving = false;
        try {
          arriving = sessionStorage.getItem(BOOT_FLAG_KEY) === "1";
          if (arriving) sessionStorage.removeItem(BOOT_FLAG_KEY);
        } catch {}
        console.log(
          "[liquid] already init, arriving:",
          arriving,
          "current:",
          !!current,
        );
        if (arriving && current) {
          current.bootShower();
        }
        return;
      }
      (svg as any).__liquidInit = true;
      console.log("[liquid] fresh init");

      // Stop the previous instance's rAF (its SVG was just removed by the
      // SPA nav, so its setAttribute calls are no-ops, but the loop is still
      // burning frames).
      if (current) current.stop();

      const surface = svg.querySelector<SVGPathElement>(
        "[data-liquid-surface]",
      );
      const dropletsGroup = svg.querySelector<SVGGElement>(
        "[data-liquid-droplets]",
      );
      const ringDisc = svg.querySelector<SVGCircleElement>("[data-ring-disc]");
      const ringMaskOuter =
        svg.querySelector<SVGCircleElement>("[data-ring-outer]");
      const ringMaskInner =
        svg.querySelector<SVGCircleElement>("[data-ring-inner]");
      const trigger =
        svg.closest<HTMLElement>("[data-brand-trigger]") ||
        (svg.parentElement as HTMLElement | null);
      if (!surface || !dropletsGroup || !trigger) return;
      if (!ringDisc || !ringMaskOuter || !ringMaskInner) return;

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      // ── Geometry ─────────────────────────────────────────────────
      const CX = 22;
      const CY = 22;
      const R_BASE = 12; // resting bowl radius (inner edge of ring)
      const OUTER_BASE = 20; // resting outer edge of ring (thickness 8)
      const SAMPLES = 16;

      // ── State ───────────────────────────────────────────────────────────
      const REST_LEVEL = 0.5;
      let level = REST_LEVEL;
      let vel = 0;
      let phase = 0;
      let waveAmp = 1.6;
      let tilt = 0;
      let targetTilt = 0;
      // Ring expansion: spring-animated additive offset added to BOTH the
      // inner and outer ring radii, so thickness stays constant (8) but the
      // ring grows in diameter on hover. The bowl path uses the inner radius
      // each frame, so the water automatically fills the new interior — no
      // separate "water lifts" animation needed.
      let ringExpand = 0;
      let ringExpandVel = 0;
      let ringTarget = 0;
      const RING_MAX_EXPAND = 3; // outer 20→23 on full hover
      // Inner expands more than outer so the ring also visually thins on
      // hover (12→16 vs outer 20→23 → thickness 8→7).
      const INNER_EXPAND_FACTOR = 4 / 3;
      const RING_K = 110;
      const RING_C = 13;
      type Mode = "idle" | "drain" | "pause" | "spring";
      let mode: Mode = "idle";
      let modeStart = 0;
      let drainStartLevel = REST_LEVEL;
      let nextDropletAt = 0;

      const DRAIN_MS = 400;
      const PAUSE_MS = 150;
      const K = 12;
      const C = 3.0;
      const C_BOOT = 4.5;
      let bootSpring = false;

      // Boot-droplet shower: when the user clicks the brand link from another
      // page, we want a few droplets to fall on arrival to imply continuity
      // with the drain they just saw on the source page.
      let bootDropletsUntil = 0;
      let bootNextDropletAt = 0;

      // ── Scroll slosh ────────────────────────────────────────────────────
      let sloshOffset = 0;
      let sloshVel = 0;
      const SLOSH_K = 70;
      const SLOSH_C = 7;

      type Droplet = {
        x: number;
        y: number;
        vy: number;
        r: number;
        alpha: number;
        el: SVGCircleElement;
      };
      const droplets: Droplet[] = [];

      // ── Path builder ────────────────────────────────────────────────────
      function buildSurfacePath() {
        // Bowl radius grows with the ring during hover, so the water fills
        // the larger interior automatically. Uses the inner radius which
        // expands faster than the outer so the ring also thins.
        const R = R_BASE + ringExpand * INNER_EXPAND_FACTOR;
        const BOTTOM = CY + R;
        const effectiveLevel = level + sloshOffset;
        const baseY = BOTTOM - effectiveLevel * (R * 2);
        const HALF_W = R + 4;
        const step = (HALF_W * 2) / SAMPLES;
        const tanTilt = Math.tan(tilt);
        let d = "";
        for (let i = 0; i <= SAMPLES; i++) {
          const x = CX - HALF_W + i * step;
          const t = i / SAMPLES;
          const wave = Math.sin(phase + t * Math.PI * 2.6) * waveAmp;
          const lean = (t - 0.5) * (HALF_W * 2) * tanTilt;
          const y = baseY + wave + lean;
          d += (i === 0 ? "M" : " L") + x.toFixed(2) + " " + y.toFixed(2);
        }
        d += " L " + (CX + HALF_W).toFixed(2) + " " + (BOTTOM + 4).toFixed(2);
        d += " L " + (CX - HALF_W).toFixed(2) + " " + (BOTTOM + 4).toFixed(2);
        d += " Z";
        return d;
      }

      // ── Droplets ────────────────────────────────────────────────────────
      function emitDroplet() {
        const R = R_BASE + ringExpand * INNER_EXPAND_FACTOR;
        const BOTTOM = CY + R;
        const x = CX + (Math.random() - 0.5) * (R * 0.9);
        const y = BOTTOM + 4 + Math.random() * 1.5;
        const r = 1.6 + Math.random() * 1.0;
        const el = document.createElementNS(SVG_NS, "circle");
        el.setAttribute("r", r.toFixed(2));
        el.setAttribute("cx", x.toFixed(2));
        el.setAttribute("cy", y.toFixed(2));
        el.setAttribute("opacity", "0.9");
        dropletsGroup!.appendChild(el);
        droplets.push({
          x,
          y,
          vy: 22 + Math.random() * 14,
          r,
          alpha: 0.9,
          el,
        });
      }

      function updateDroplets(dt: number) {
        for (let i = droplets.length - 1; i >= 0; i--) {
          const d = droplets[i];
          d.vy += 220 * dt;
          d.y += d.vy * dt;
          d.alpha -= dt * 2.4;
          if (d.y > 72 || d.alpha <= 0) {
            d.el.remove();
            droplets.splice(i, 1);
          } else {
            d.el.setAttribute("cy", d.y.toFixed(2));
            d.el.setAttribute("opacity", Math.max(0, d.alpha).toFixed(2));
          }
        }
      }

      // ── rAF loop ────────────────────────────────────────────────────────
      let rafId = 0;
      let lastTime = 0;
      let running = false;

      function tick(now: number) {
        const dtRaw = lastTime ? (now - lastTime) / 1000 : 0.016;
        const dt = Math.min(0.05, dtRaw);
        lastTime = now;

        phase += dt * 0.7;
        tilt += (targetTilt - tilt) * Math.min(1, dt * 6);

        const sloshAcc = -SLOSH_K * sloshOffset - SLOSH_C * sloshVel;
        sloshVel += sloshAcc * dt;
        sloshOffset += sloshVel * dt;

        if (mode === "drain") {
          const t = Math.min(1, (now - modeStart) / DRAIN_MS);
          const eased = t * t;
          level = drainStartLevel * (1 - eased);
          waveAmp = 1.6 + eased * 2.0;

          if (now >= nextDropletAt && t < 0.95 && droplets.length < 8) {
            emitDroplet();
            nextDropletAt = now + 55 + Math.random() * 50;
          }

          if (t >= 1) {
            level = 0;
            mode = "pause";
            modeStart = now;
          }
        } else if (mode === "pause") {
          level = 0;
          waveAmp = 1.2;
          if (now - modeStart >= PAUSE_MS) {
            mode = "spring";
            vel = 0;
          }
        } else if (mode === "spring") {
          const damp = bootSpring ? C_BOOT : C;
          const acc = -K * (level - REST_LEVEL) - damp * vel;
          vel += acc * dt;
          level += vel * dt;
          waveAmp = 1.6 + Math.min(3.5, Math.abs(vel) * 5);

          if (Math.abs(level - REST_LEVEL) < 0.003 && Math.abs(vel) < 0.05) {
            level = REST_LEVEL;
            vel = 0;
            mode = "idle";
            bootSpring = false;
          }
        } else {
          const breath = Math.sin(now * 0.00055) * 0.025;
          level = REST_LEVEL + breath;
          const sloshTurb = Math.min(2.5, Math.abs(sloshVel) * 8);
          waveAmp = 1.6 + Math.sin(now * 0.00075) * 0.5 + sloshTurb;
        }

        // Boot droplet shower: independent of mode, runs for a short window
        // after arrival so the destination page picks up where the source's
        // drain left off.
        if (
          now < bootDropletsUntil &&
          now >= bootNextDropletAt &&
          droplets.length < 6
        ) {
          emitDroplet();
          bootNextDropletAt = now + 120 + Math.random() * 100;
        }

        // Ring expansion spring (independent of water spring).
        const ringAcc =
          -RING_K * (ringExpand - ringTarget) - RING_C * ringExpandVel;
        ringExpandVel += ringAcc * dt;
        ringExpand += ringExpandVel * dt;

        updateDroplets(dt);
        surface!.setAttribute("d", buildSurfacePath());

        // Drive ring radii from ringExpand. Outer grows by ringExpand;
        // inner grows slightly faster so the ring also thins on hover.
        const outerR = OUTER_BASE + ringExpand;
        const innerR = R_BASE + ringExpand * INNER_EXPAND_FACTOR;
        ringDisc!.setAttribute("r", outerR.toFixed(2));
        ringMaskOuter!.setAttribute("r", outerR.toFixed(2));
        ringMaskInner!.setAttribute("r", innerR.toFixed(2));

        rafId = requestAnimationFrame(tick);
      }

      function start() {
        if (running) return;
        running = true;
        lastTime = 0;
        rafId = requestAnimationFrame(tick);
      }

      function stop() {
        if (!running) return;
        running = false;
        cancelAnimationFrame(rafId);
      }

      function renderStatic() {
        level = REST_LEVEL;
        waveAmp = 0;
        tilt = 0;
        phase = 0;
        ringExpand = 0;
        ringExpandVel = 0;
        ringTarget = 0;
        surface!.setAttribute("d", buildSurfacePath());
        ringDisc!.setAttribute("r", String(OUTER_BASE));
        ringMaskOuter!.setAttribute("r", String(OUTER_BASE));
        ringMaskInner!.setAttribute("r", String(R_BASE));
      }

      function pumpScroll(dy: number) {
        if (reduceMotion.matches) return;
        sloshVel -= dy * 0.0009;
        if (sloshVel > 0.6) sloshVel = 0.6;
        else if (sloshVel < -0.6) sloshVel = -0.6;
      }

      function bootShower() {
        if (reduceMotion.matches) return;
        // Match the on-home kick: start full, push down, bounce back
        level = REST_LEVEL;
        kick();
      }

      // ── Click handling ──────────────────────────────────────────────────
      // Use document-level delegation so the handler survives SPA navs
      // (transition:persist keeps the SVG but the <a> wrapper is replaced).
      //
      // CRITICAL: bind in the CAPTURE phase. Astro's ClientRouter attaches
      // its own click listener on document (bubble phase) at startup, before
      // our handler is bound. If we bind in bubble phase, Astro's listener
      // fires first and kicks off SPA navigation before our preventDefault
      // can stop it — so a same-page click on the brand link from / back to
      // / would still trigger a full SPA nav, replaying the page's rise-in
      // animation. Capture phase makes us run first, so preventDefault()
      // takes effect before ClientRouter sees the click.
      if (!(window as any).__liquidClickBound) {
        (window as any).__liquidClickBound = true;

        document.addEventListener(
          "click",
          (e) => {
            const brandLink = (e.target as HTMLElement).closest<HTMLElement>(
              "[data-brand-trigger]",
            );
            if (!brandLink || !current) return;
            if (current.reduceMotion.matches) return;

            const isHome =
              window.location.pathname === "/" ||
              window.location.pathname === "/index.html";

            if (isHome) {
              // Already home — never navigate. Just kick the logo and (if
              // scrolled) smooth-scroll back to top. Stop propagation so
              // Astro's ClientRouter doesn't see the click at all.
              e.preventDefault();
              e.stopPropagation();
              current.kick();
              if (window.scrollY > 0) {
                window.scrollTo({ top: 0, behavior: "smooth" });
              }
              return;
            }

            // Non-home: trigger drain; SPA nav happens on its own and the
            // animation plays through because the SVG is persisted.
            current.drain();
          },
          true,
        ); // capture phase
      }
      function kick() {
        mode = "spring";
        bootSpring = false;
        const k = 1.4 + Math.random() * 1.2;
        vel = Math.max(-4.5, Math.min(4.5, vel - k));
        sloshVel += (Math.random() - 0.5) * 0.55;
        sloshVel = Math.max(-0.8, Math.min(0.8, sloshVel));
        phase += 0.6 + Math.random() * 0.8;
        waveAmp = Math.min(5, waveAmp + 1.2 + Math.random() * 0.8);
        const burst = 3 + Math.floor(Math.random() * 2);
        for (let i = 0; i < burst; i++) {
          if (droplets.length < 10) emitDroplet();
        }
        const t0 = performance.now();
        bootDropletsUntil = t0 + 700;
        bootNextDropletAt = t0 + 80;
      }

      function drain() {
        // Allow drain to interrupt any non-drain mode. Previously this
        // bailed out when mode !== "idle", which meant clicking the brand
        // link on /about while the home-page kick spring was still settling
        // would silently skip the drain → no droplets, no animation, just
        // a bare SPA nav. The "click feels dead sometimes" bug.
        if (mode === "drain") return;
        drainStartLevel = level > 0.05 ? level : REST_LEVEL;
        mode = "drain";
        modeStart = performance.now();
        nextDropletAt = performance.now();
      }

      // Hover/focus state setters — exposed via `current` so document-level
      // delegated listeners (bound once per session) can drive whichever
      // instance is currently mounted. No splash here: the ring spring alone
      // produces a smooth, continuous transition because level=0.5 keeps the
      // waterline at CY while the bowl walls grow around it.
      let isHovered = false;
      let isPressed = false;
      function syncRingTarget() {
        // Press collapses the hover expansion back to rest (no overshoot
        // smaller than normal). Hover expands. Neither = rest.
        if (isPressed) ringTarget = 0;
        else if (isHovered) ringTarget = RING_MAX_EXPAND;
        else ringTarget = 0;
      }
      function setHover(active: boolean) {
        if (active && reduceMotion.matches) return;
        isHovered = active;
        if (!active) targetTilt = 0;
        syncRingTarget();
        // Persist hover state across navigations (incl. full reloads from
        // the brand link's data-astro-reload). The pre-paint inline script
        // reads this flag to seed the new page's SVG before first paint.
        try {
          if (active) sessionStorage.setItem("liquidLogo:hovered", "1");
          else sessionStorage.removeItem("liquidLogo:hovered");
        } catch {}
      }
      function setPressed(active: boolean) {
        if (reduceMotion.matches) return;
        isPressed = active;
        syncRingTarget();
      }
      function setTilt(clientX: number) {
        if (reduceMotion.matches) return;
        const rect = svg.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const half = rect.width / 2 || 1;
        const dx = Math.max(-1, Math.min(1, (clientX - cx) / half));
        targetTilt = dx * 0.06;
      }

      // ── Reduced motion ──────────────────────────────────────────────────
      function handleMotionPref() {
        if (reduceMotion.matches) {
          stop();
          droplets.forEach((d) => d.el.remove());
          droplets.length = 0;
          renderStatic();
        } else {
          start();
        }
      }
      if ("addEventListener" in reduceMotion) {
        reduceMotion.addEventListener("change", handleMotionPref);
      }

      // ── Boot ────────────────────────────────────────────────────────────
      // Pick up the pre-paint inline script's verdict: if it determined
      // the cursor was over the brand link at page load and already wrote
      // expanded radii to the SVG, start the simulation already at MAX so
      // the spring is at rest there — no animation up from 0.
      if (
        !reduceMotion.matches &&
        ((window as any).__liquidPreHover ||
          (lastPointer &&
            document
              .elementFromPoint(lastPointer.x, lastPointer.y)
              ?.closest?.("[data-brand-trigger]")))
      ) {
        ringExpand = RING_MAX_EXPAND;
        ringTarget = RING_MAX_EXPAND;
        (window as any).__liquidPreHover = false;
      }

      if (reduceMotion.matches) {
        renderStatic();
      } else {
        // If we got here from a brand-link click on another page, replay
        // a brief droplet shower to imply continuity.
        let arriving = false;
        try {
          arriving = sessionStorage.getItem(BOOT_FLAG_KEY) === "1";
          if (arriving) sessionStorage.removeItem(BOOT_FLAG_KEY);
        } catch {}

        console.log("[liquid] boot path, arriving:", arriving);
        if (arriving) {
          level = REST_LEVEL;
          start();
          kick();
        } else {
          level = 0.12 + Math.random() * 0.16;
          vel = (Math.random() - 0.3) * 1.2;
          tilt = (Math.random() - 0.5) * 0.12;
          phase = Math.random() * Math.PI * 2;
          mode = "spring";
          bootSpring = true;
        }
        start();
      }

      current = {
        start,
        stop,
        pumpScroll,
        bootShower,
        kick,
        drain,
        setHover,
        setTilt,
        setPressed,
        reduceMotion,
      };
    }

    // Re-init on every page (initial + every SPA nav under ClientRouter).
    document.addEventListener("astro:page-load", () => {
      initLiquidLogo();
      // After SPA nav, the brand <a> is a fresh DOM node so the previous
      // pointerover never fired for it. Re-evaluate hover state from the
      // last known pointer position so a hover started on the previous page
      // carries through visually.
      //
      // Defer to rAF so this runs AFTER any pointerout events triggered by
      // the DOM swap (which would otherwise overwrite our setHover call).
      const reapplyHover = () => {
        if (current && lastPointer) {
          const el = document.elementFromPoint(lastPointer.x, lastPointer.y);
          const overBrand = !!el?.closest?.("[data-brand-trigger]");
          current.setHover(overBrand);
          if (overBrand) current.setTilt(lastPointer.x);
        }
      };
      requestAnimationFrame(() => {
        reapplyHover();
        // One more on the next frame in case pointerout straggles in.
        requestAnimationFrame(reapplyHover);
      });
    });

    // One-time global listeners that talk to whichever instance is current.
    if (!(window as any).__liquidLogoGlobal) {
      (window as any).__liquidLogoGlobal = true;
      let lastPointerSaveAt = 0;

      // Document-delegated hover/focus so it works across SPA navs (the
      // brand <a> is recreated each nav, but the persisted SVG and our
      // module-scope `current` are stable). Use pointerover/out which
      // bubble, and ignore inner-element transitions via relatedTarget.
      document.addEventListener("pointerover", (e) => {
        if (!current) return;
        const t = (e.target as HTMLElement | null)?.closest?.(
          "[data-brand-trigger]",
        );
        if (!t) return;
        const from = (e.relatedTarget as HTMLElement | null)?.closest?.(
          "[data-brand-trigger]",
        );
        if (from === t) return;
        current.setHover(true);
      });
      document.addEventListener("pointerout", (e) => {
        if (!current) return;
        const t = (e.target as HTMLElement | null)?.closest?.(
          "[data-brand-trigger]",
        );
        if (!t) return;
        const to = (e.relatedTarget as HTMLElement | null)?.closest?.(
          "[data-brand-trigger]",
        );
        if (to === t) return;
        current.setHover(false);
      });
      document.addEventListener("pointermove", (e) => {
        lastPointer = { x: e.clientX, y: e.clientY };
        // Throttled mirror to sessionStorage so a full reload (brand link is
        // data-astro-reload) can pick up where we left off.
        const nowMs = performance.now();
        if (nowMs - lastPointerSaveAt > 60) {
          lastPointerSaveAt = nowMs;
          try {
            sessionStorage.setItem(POINTER_KEY, JSON.stringify(lastPointer));
          } catch {}
        }
        if (!current) return;
        const t = (e.target as HTMLElement | null)?.closest?.(
          "[data-brand-trigger]",
        );
        if (!t) return;
        current.setTilt(e.clientX);
      });
      document.addEventListener("focusin", (e) => {
        if (!current) return;
        const t = (e.target as HTMLElement | null)?.closest?.(
          "[data-brand-trigger]",
        );
        if (t) current.setHover(true);
      });
      document.addEventListener("focusout", (e) => {
        if (!current) return;
        const t = (e.target as HTMLElement | null)?.closest?.(
          "[data-brand-trigger]",
        );
        if (t) current.setHover(false);
      });

      // Press-down on the brand link: ring shrinks while held. Released on
      // pointerup ANYWHERE so we don't get stuck pressed if the user drags
      // off before releasing.
      document.addEventListener("pointerdown", (e) => {
        if (!current) return;
        const t = (e.target as HTMLElement | null)?.closest?.(
          "[data-brand-trigger]",
        );
        if (!t) return;
        current.setPressed(true);
      });
      const releasePress = () => current?.setPressed(false);
      document.addEventListener("pointerup", releasePress);
      document.addEventListener("pointercancel", releasePress);
      window.addEventListener("blur", releasePress);
      // Keyboard activation (Enter/Space) on focused brand link.
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Enter" && e.key !== " ") return;
        const t = (document.activeElement as HTMLElement | null)?.closest?.(
          "[data-brand-trigger]",
        );
        if (t) current?.setPressed(true);
      });
      document.addEventListener("keyup", (e) => {
        if (e.key !== "Enter" && e.key !== " ") return;
        current?.setPressed(false);
      });
      let lastScrollY = window.scrollY || 0;
      window.addEventListener(
        "scroll",
        () => {
          if (!current) return;
          const y = window.scrollY || 0;
          const dy = y - lastScrollY;
          lastScrollY = y;
          current.pumpScroll(dy);
        },
        { passive: true },
      );
      document.addEventListener("visibilitychange", () => {
        if (!current || current.reduceMotion.matches) return;
        if (document.hidden) current.stop();
        else current.start();
      });
    }
  })();
</script>
