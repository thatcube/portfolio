---
import { Icon } from 'astro-icon/components';
---

<footer class="border-t border-border/10 mt-24">
  <div class="max-w-5xl mx-auto px-6 py-12 flex flex-col sm:flex-row justify-between items-center gap-6">
    <p class="text-sm text-primary/60">
      Made with <span class="footer-heart" aria-hidden="true">♥</span><span class="sr-only">love</span> by Brandon. Say hi on
      <a
        href="https://www.linkedin.com/in/bmoore46/"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
      >LinkedIn</a>
      or
      <a
        href="mailto:brandoncmoore4@gmail.com"
        class="footer-link"
      >email</a>.
    </p>
    <div class="flex items-center gap-6">
      <!-- Theme Switcher -->
      <div
        class="theme-switcher flex items-center rounded-xl p-1 gap-1"
        role="radiogroup"
        aria-label="Color theme"
      >
        <span class="theme-indicator" aria-hidden="true"></span>
        <span class="theme-effects" aria-hidden="true"></span>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme="light"
          data-tooltip="Light"
          aria-label="Light mode"
          class="theme-btn p-2 rounded-lg"
        >
          <Icon name="ph:sun" class="theme-icon theme-icon-outline w-4 h-4" aria-hidden="true" />
          <Icon name="ph:sun-fill" class="theme-icon theme-icon-solid w-4 h-4" aria-hidden="true" />
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme="system"
          data-tooltip="System"
          aria-label="System theme"
          class="theme-btn p-2 rounded-lg"
        >
          <Icon name="ph:circle-half" class="theme-icon theme-icon-outline w-4 h-4" aria-hidden="true" />
          <Icon name="ph:circle-half-fill" class="theme-icon theme-icon-solid w-4 h-4" aria-hidden="true" />
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme="dark"
          data-tooltip="Dark"
          aria-label="Dark mode"
          class="theme-btn p-2 rounded-lg"
        >
          <Icon name="ph:moon" class="theme-icon theme-icon-outline w-4 h-4" aria-hidden="true" />
          <Icon name="ph:moon-fill" class="theme-icon theme-icon-solid w-4 h-4" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  .theme-switcher {
    position: relative;
    isolation: isolate;
    /* Subtle airy container — no border, just a soft tinted backdrop to
       group the controls. */
    background-color: color-mix(in srgb, var(--color-primary) 4%, transparent);
    /* Indicator fill strength is theme-aware: lighter on light surfaces (so
       the blob feels airy, not muddy), a touch stronger on dark surfaces
       where it needs to read against a deeper background. Both stay well
       above the 3:1 non-text contrast threshold. */
    --theme-indicator-mix: 10%;
  }
  :where(html.dark) .theme-switcher,
  :where(html:not(.light)) .theme-switcher {
    --theme-indicator-mix: 14%;
  }
  @media (prefers-color-scheme: light) {
    :where(html:not(.dark)) .theme-switcher { --theme-indicator-mix: 10%; }
  }

  /* Sliding "liquid" indicator that morphs between active buttons. */
  .theme-indicator {
    position: absolute;
    top: 4px;
    left: var(--indicator-x, 0px);
    width: var(--indicator-w, 0px);
    height: calc(100% - 8px);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-primary) var(--theme-indicator-mix, 12%), transparent);
    transform-origin: center;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition:
      left 0.4s cubic-bezier(0.32, 0.72, 0, 1),
      width 0.4s cubic-bezier(0.32, 0.72, 0, 1),
      transform 0.42s cubic-bezier(0.34, 1.4, 0.56, 1),
      opacity 0.2s ease;
    will-change: left, width, transform;
  }
  .theme-switcher[data-ready] .theme-indicator { opacity: 1; }
  .theme-switcher[data-sliding] .theme-indicator {
    transform: scaleY(0.86);
  }

  /* Effect overlay — sits above tooltip layer so emitted ornaments aren't
     clipped or hidden behind anything. The actual ornament elements
     (rays, z's) are styled in the global block below because they're
     created in JS and don't carry Astro's scoped-CSS attribute. */
  .theme-effects {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
    z-index: 30;
  }

  .theme-btn {
    color: var(--color-primary);
    /* Inactive icons sit at ~60% — comfortably above the 3:1 non-text
       contrast threshold in both themes while still reading as secondary. */
    opacity: 0.6;
    position: relative;
    z-index: 1;
    cursor: pointer;
    /* Stack outline + solid SVGs in the same slot. */
    display: inline-grid;
    place-items: center;
    transition:
      opacity 0.18s ease,
      transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .theme-icon {
    grid-area: 1 / 1;
    /* Pure cross-fade between outline and solid. The spring scale-in is
       reserved for the freshly-activated button via the `theme-icon-pop`
       keyframe — animating scale on every state change made the
       deactivating button look like it was wilting. */
    transition: opacity 0.2s ease;
  }
  /* Default: show outline, hide solid. Both at natural scale so a state
     swap is a simple cross-fade with no perceived shrink. */
  .theme-icon-solid { opacity: 0; }
  .theme-icon-outline { opacity: 1; }
  /* Active: outline out, solid in. */
  .theme-btn[data-active] .theme-icon-outline { opacity: 0; }
  .theme-btn[data-active] .theme-icon-solid { opacity: 1; }
  .theme-btn:hover { opacity: 0.9; }
  .theme-btn:hover .theme-icon { transform: scale(1.08); }
  .theme-btn:active .theme-icon { transform: scale(0.92); }
  .theme-btn[data-active] { opacity: 1; }
  /* "Lights on" flash: when the sun is freshly activated, briefly glow the
     same warm amber as its ray burst, then settle back to the standard
     primary tint so the icon stays legible against any surface.
     Easing is linear for the color so the fade-down doesn't snap; the
     drop-shadow has its own gentler curve via the filter waypoints. */
  .theme-btn[data-theme="light"][data-just-activated] .theme-icon-solid {
    animation:
      theme-icon-pop 0.5s cubic-bezier(0.34, 1.6, 0.5, 1),
      theme-sun-glow 0.6s ease-out;
  }
  @keyframes theme-sun-glow {
    0% {
      color: var(--color-primary);
      filter: none;
    }
    20% {
      color: #f59e0b;
      filter: drop-shadow(0 0 6px color-mix(in srgb, #f59e0b 70%, transparent));
    }
    60% {
      color: #d18a18;
      filter: drop-shadow(0 0 2px color-mix(in srgb, #f59e0b 25%, transparent));
    }
    100% {
      color: var(--color-primary);
      filter: none;
    }
  }
  /* "Moonlight on" flash: when the moon is freshly activated, glow a soft
     lavender (matching the night-sky palette) before settling back. */
  .theme-btn[data-theme="dark"][data-just-activated] .theme-icon-solid {
    animation:
      theme-icon-pop 0.5s cubic-bezier(0.34, 1.6, 0.5, 1),
      theme-moon-glow 0.6s ease-out;
  }
  @keyframes theme-moon-glow {
    0% {
      color: var(--color-primary);
      filter: none;
    }
    20% {
      color: #c4b5fd;
      filter: drop-shadow(0 0 6px color-mix(in srgb, #c4b5fd 70%, transparent));
    }
    60% {
      color: #a78bfa;
      filter: drop-shadow(0 0 2px color-mix(in srgb, #c4b5fd 25%, transparent));
    }
    100% {
      color: var(--color-primary);
      filter: none;
    }
  }
  /* Tiny "pop" only on the button that was just activated — keeps the
     other-button transition a calm fade. */
  .theme-btn[data-just-activated] .theme-icon-solid {
    animation: theme-icon-pop 0.5s cubic-bezier(0.34, 1.6, 0.5, 1);
  }
  @keyframes theme-icon-pop {
    0%   { opacity: 0; transform: scale(0.6) rotate(-8deg); }
    45%  { opacity: 1; transform: scale(1.18) rotate(4deg); }
    100% { opacity: 1; transform: scale(1) rotate(0); }
  }

  /* ── Tooltip ────────────────────────────────────────────────────────── */
  .theme-btn::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(4px) scale(0.94);
    padding: 6px 10px;
    border-radius: 7px;
    background-color: var(--color-primary);
    color: var(--color-surface);
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    box-shadow:
      0 10px 24px -8px color-mix(in srgb, var(--color-primary) 55%, transparent),
      0 2px 4px -1px color-mix(in srgb, var(--color-primary) 35%, transparent);
    opacity: 0;
    pointer-events: none;
    z-index: 20;
    transition:
      opacity 0.18s ease,
      transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  /* Tooltip arrow */
  .theme-btn::before {
    content: "";
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    transform: translateX(-50%) translateY(4px) rotate(45deg) scale(0.8);
    border-radius: 1.5px;
    opacity: 0;
    pointer-events: none;
    z-index: 19;
    transition:
      opacity 0.18s ease,
      transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .theme-btn:hover::after,
  .theme-btn:focus-visible::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }
  .theme-btn:hover::before,
  .theme-btn:focus-visible::before {
    opacity: 1;
    transform: translateX(-50%) translateY(0) rotate(45deg) scale(1);
  }
  /* Prevent stacked tooltips: when a sibling is being hovered,
     suppress focus-visible tooltips on the others. */
  [role="radiogroup"]:has(.theme-btn:hover) .theme-btn:focus-visible:not(:hover)::after,
  [role="radiogroup"]:has(.theme-btn:hover) .theme-btn:focus-visible:not(:hover)::before {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-btn,
    .theme-btn svg,
    .theme-indicator,
    .theme-btn::after,
    .theme-btn::before {
      transition-duration: 0.01ms !important;
      animation: none !important;
    }
    .theme-btn[data-just-activated] svg { animation: none; }
  }

  .footer-link {
    color: var(--color-primary);
    opacity: 0.85;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 25%, transparent);
    text-underline-offset: 3px;
    transition: opacity 0.15s ease, text-decoration-color 0.15s ease;
  }
  .footer-link:hover,
  .footer-link:focus-visible {
    opacity: 1;
    text-decoration-color: currentColor;
  }

  .footer-heart {
    display: inline-block;
    color: #ef4444;
    transform: translateY(1px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .footer-heart {
      animation: footer-heartbeat 1.6s ease-in-out infinite;
    }
  }
  @keyframes footer-heartbeat {
    0%, 60%, 100% { transform: translateY(1px) scale(1); }
    20% { transform: translateY(1px) scale(1.18); }
    40% { transform: translateY(1px) scale(1.05); }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<!-- Effect ornament styles must be global because the elements are created
     in JS and don't carry Astro's scoped-CSS attribute. Class names are
     namespaced enough to be safe at global scope. -->
<style is:global>
  /* Light mode → sun rays bursting outward from the icon. Warm amber
     keeps the metaphor on-brand regardless of the surface theme. */
  .theme-ray {
    position: absolute;
    width: 2px;
    height: 7px;
    margin-left: -1px;
    margin-top: -3.5px;
    border-radius: 1.5px;
    background: #f59e0b;
    box-shadow: 0 0 6px color-mix(in srgb, #f59e0b 60%, transparent);
    pointer-events: none;
    will-change: transform, opacity;
  }
  /* Dark mode → cartoon sleeping z's drifting up-and-right. */
  .theme-zzz {
    position: absolute;
    font-family: var(--font-mono);
    font-weight: 700;
    font-style: italic;
    color: #a78bfa;
    text-shadow: 0 0 6px color-mix(in srgb, #c4b5fd 55%, transparent);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    will-change: transform, opacity;
  }
</style>

<script>
  function applyTheme(setting: string) {
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const isDark = setting === "dark" || (setting === "system" && prefersDark);
    const root = document.documentElement;
    root.classList.remove("dark", "light");
    if (isDark) {
      root.classList.add("dark");
    } else if (setting === "light") {
      root.classList.add("light");
    }
  }

  function updateButtons(active: string) {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".theme-btn")
    );
    const hasActive = buttons.some((b) => b.dataset.theme === active);
    buttons.forEach((btn) => {
      const isActive = btn.dataset.theme === active;
      btn.setAttribute("aria-checked", isActive ? "true" : "false");
      // Roving tabindex: only the checked radio (or first, as fallback) is tabbable.
      btn.tabIndex = isActive || (!hasActive && btn === buttons[0]) ? 0 : -1;
      if (isActive) {
        btn.setAttribute("data-active", "");
      } else {
        btn.removeAttribute("data-active");
      }
    });
    moveIndicator();
  }

  // Slide the liquid-pill indicator under the active button. Brief
  // `data-sliding` flag triggers a slosh/squish during the transit.
  let slideTimeout: number | undefined;
  function moveIndicator() {
    const switcher = document.querySelector<HTMLElement>(".theme-switcher");
    if (!switcher) return;
    const indicator = switcher.querySelector<HTMLElement>(".theme-indicator");
    const active = switcher.querySelector<HTMLElement>(".theme-btn[data-active]");
    if (!indicator || !active) return;

    const sRect = switcher.getBoundingClientRect();
    const bRect = active.getBoundingClientRect();
    const x = bRect.left - sRect.left;
    indicator.style.width = bRect.width + "px";
    indicator.style.setProperty("--indicator-x", x + "px");

    switcher.setAttribute("data-ready", "");
    switcher.setAttribute("data-sliding", "");
    window.clearTimeout(slideTimeout);
    slideTimeout = window.setTimeout(() => {
      switcher.removeAttribute("data-sliding");
    }, 420);
  }

  // Emit a theme-appropriate ornament from the clicked button.
  //   light  → sun rays burst radially outward
  //   dark   → trio of "z"s drift up-and-right (sleeping)
  //   system → silent (no ornament)
  function emitEffect(btn: HTMLElement) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const switcher = btn.closest<HTMLElement>(".theme-switcher");
    const layer = switcher?.querySelector<HTMLElement>(".theme-effects");
    if (!switcher || !layer) return;

    const sRect = switcher.getBoundingClientRect();
    const bRect = btn.getBoundingClientRect();
    const cx = bRect.left - sRect.left - switcher.clientLeft + bRect.width / 2;
    const cy = bRect.top - sRect.top - switcher.clientTop + bRect.height / 2;

    const theme = btn.dataset.theme;
    if (theme === "light") emitRays(layer, cx, cy);
    else if (theme === "dark") emitZzz(layer, cx, cy);
    // system: intentionally silent
  }

  function emitRays(layer: HTMLElement, cx: number, cy: number) {
    const count = 8;
    const startDist = 11;
    const endDist = 22;
    for (let i = 0; i < count; i++) {
      const ray = document.createElement("span");
      ray.className = "theme-ray";
      ray.style.left = cx + "px";
      ray.style.top = cy + "px";
      const angle = (i / count) * 360;
      layer.appendChild(ray);

      const anim = ray.animate(
        [
          {
            transform: `rotate(${angle}deg) translateY(-${startDist}px) scaleY(0.4)`,
            opacity: 0,
          },
          {
            transform: `rotate(${angle}deg) translateY(-${startDist + 3}px) scaleY(1)`,
            opacity: 1,
            offset: 0.35,
          },
          {
            transform: `rotate(${angle}deg) translateY(-${endDist}px) scaleY(0.5)`,
            opacity: 0,
          },
        ],
        {
          duration: 560,
          delay: i * 18,
          easing: "cubic-bezier(0.34, 0, 0.64, 1)",
          fill: "forwards",
        }
      );
      anim.onfinish = () => ray.remove();
    }
  }

  function emitZzz(layer: HTMLElement, cx: number, cy: number) {
    // Anchor the trio at the upper-right of the icon (where cartoon
    // sleep-z's typically emanate from), then drift further up-and-right.
    // Each z has its own little starting spread so they're never visibly
    // stacked at a single point — even on the very first frame.
    const anchorX = cx + 7;
    const anchorY = cy - 5;
    // Each z gets its own start offset AND drift vector so the trio fans
    // out into a sleep-puff instead of trailing in a single line.
    const zs = [
      { text: "z", size: 9,  delay: 0,   ox: -4, oy:  3, dx:  4, dy: -14 },
      { text: "z", size: 11, delay: 140, ox:  1, oy:  0, dx: 11, dy: -17 },
      { text: "Z", size: 13, delay: 280, ox:  6, oy: -3, dx: 18, dy: -20 },
    ];
    for (const { text, size, delay, ox, oy, dx, dy } of zs) {
      const z = document.createElement("span");
      z.className = "theme-zzz";
      z.textContent = text;
      z.style.left = (anchorX + ox) + "px";
      z.style.top = (anchorY + oy) + "px";
      z.style.fontSize = size + "px";
      // Pre-apply the first keyframe inline so the initial paint already
      // matches it. Without this the element flashes at its raw left/top
      // (top-left corner anchored) for one frame before the animation
      // kicks in and re-centers via translate(-50%, -50%).
      z.style.transform = "translate(-50%, -50%) scale(0.5)";
      z.style.opacity = "0";
      layer.appendChild(z);

      const driftX = dx + (Math.random() - 0.5) * 2;
      const driftY = dy + (Math.random() - 0.5) * 2;
      const anim = z.animate(
        [
          {
            transform: `translate(-50%, -50%) scale(0.5)`,
            opacity: 0,
          },
          {
            transform: `translate(calc(-50% + ${(driftX * 0.3).toFixed(1)}px), calc(-50% + ${(driftY * 0.3).toFixed(1)}px)) scale(1)`,
            opacity: 1,
            offset: 0.25,
          },
          {
            transform: `translate(calc(-50% + ${driftX.toFixed(1)}px), calc(-50% + ${driftY.toFixed(1)}px)) scale(0.85)`,
            opacity: 0,
          },
        ],
        {
          duration: 1100,
          delay,
          easing: "cubic-bezier(0.4, 0, 0.6, 1)",
          fill: "forwards",
        }
      );
      anim.onfinish = () => z.remove();
    }
  }

  // ClientRouter replaces the footer DOM on every navigation, so we need to
  // re-bind listeners after each swap. `astro:page-load` fires on the initial
  // load and after every view-transition swap.
  function bindThemeButtons() {
    const themeButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".theme-btn")
    );

    function selectTheme(btn: HTMLButtonElement, focus = false) {
      const theme = btn.dataset.theme!;
      localStorage.setItem("theme", theme);
      applyTheme(theme);
      updateButtons(theme);
      if (focus) btn.focus();
      // Always emit the theme-appropriate ornament on click — even if the
      // theme didn't actually change, it confirms the click registered.
      emitEffect(btn);
      // Always replay the icon pop + glow on click (not just on transition),
      // so spam-clicking the active theme keeps showing the full reaction
      // (rays + bounce + amber flash) rather than only the ornament burst.
      // Re-toggle the attribute so the keyframe restarts even on repeats.
      btn.removeAttribute("data-just-activated");
      // Force a reflow so the browser registers the removal before re-adding.
      void btn.offsetWidth;
      btn.setAttribute("data-just-activated", "");
      window.clearTimeout((btn as any).__justActivatedTimer);
      (btn as any).__justActivatedTimer = window.setTimeout(
        () => btn.removeAttribute("data-just-activated"),
        700
      );
    }

    themeButtons.forEach((btn, idx) => {
      btn.addEventListener("click", () => selectTheme(btn));

      btn.addEventListener("keydown", (e) => {
        let nextIdx: number | null = null;
        switch (e.key) {
          case "ArrowRight":
          case "ArrowDown":
            nextIdx = (idx + 1) % themeButtons.length;
            break;
          case "ArrowLeft":
          case "ArrowUp":
            nextIdx = (idx - 1 + themeButtons.length) % themeButtons.length;
            break;
          case "Home":
            nextIdx = 0;
            break;
          case "End":
            nextIdx = themeButtons.length - 1;
            break;
        }
        if (nextIdx !== null) {
          e.preventDefault();
          selectTheme(themeButtons[nextIdx], true);
        }
      });
    });

    const saved = localStorage.getItem("theme") || "system";
    applyTheme(saved);
    updateButtons(saved);
    // Indicator measures DOM rects, which can be stale before layout settles
    // (especially after a view-transition swap).
    requestAnimationFrame(moveIndicator);
  }

  bindThemeButtons();
  document.addEventListener("astro:page-load", bindThemeButtons);
  window.addEventListener("resize", moveIndicator);

  // OS-level scheme changes only need to be wired once per browsing session.
  if (!(window as any).__themeOsListenerBound) {
    (window as any).__themeOsListenerBound = true;
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
      const current = localStorage.getItem("theme") || "system";
      if (current === "system") {
        applyTheme("system");
      }
    });
  }
</script>
