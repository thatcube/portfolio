---
---

<footer class="border-t border-border/10 mt-24">
  <div class="max-w-5xl mx-auto px-6 py-12 flex flex-col sm:flex-row justify-between items-center gap-6">
    <p class="text-sm text-primary/60">
      Made with <span class="footer-heart" aria-hidden="true">♥</span><span class="sr-only">love</span> by Brandon. Say hi on
      <a
        href="https://www.linkedin.com/in/bmoore46/"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
      >LinkedIn</a>
      or
      <a
        href="mailto:brandoncmoore4@gmail.com"
        class="footer-link"
      >email</a>.
    </p>
    <div class="flex items-center gap-6">
      <!-- Theme Switcher -->
      <div
        class="flex items-center rounded-lg border border-border/10 p-0.5 gap-0.5"
        role="radiogroup"
        aria-label="Color theme"
      >
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme="light"
          data-tooltip="Light"
          aria-label="Light mode"
          class="theme-btn p-1.5 rounded-md transition-colors"
        >
          <svg class="w-4 h-4" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme="system"
          data-tooltip="System"
          aria-label="System theme"
          class="theme-btn p-1.5 rounded-md transition-colors"
        >
          <svg class="w-4 h-4" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25A2.25 2.25 0 015.25 3h13.5A2.25 2.25 0 0121 5.25z" />
          </svg>
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme="dark"
          data-tooltip="Dark"
          aria-label="Dark mode"
          class="theme-btn p-1.5 rounded-md transition-colors"
        >
          <svg class="w-4 h-4" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  .theme-btn {
    color: var(--color-primary);
    opacity: 0.5;
    position: relative;
  }
  .theme-btn[data-active] {
    opacity: 0.9;
    background-color: rgba(128, 128, 128, 0.12);
  }
  .theme-btn::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(2px);
    padding: 5px 9px;
    border-radius: 6px;
    background-color: var(--color-primary);
    color: var(--color-surface);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.18);
    opacity: 0;
    pointer-events: none;
    z-index: 10;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .theme-btn:hover::after,
  .theme-btn:focus-visible::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  /* Prevent stacked tooltips: when a sibling is being hovered,
     suppress focus-visible tooltips on the others. */
  [role="radiogroup"]:has(.theme-btn:hover) .theme-btn:focus-visible:not(:hover)::after {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-btn::after { transition: opacity 0.15s ease; transform: translateX(-50%); }
    .theme-btn:hover::after,
    .theme-btn:focus-visible::after { transform: translateX(-50%); }
  }

  .footer-link {
    color: var(--color-primary);
    opacity: 0.85;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 25%, transparent);
    text-underline-offset: 3px;
    transition: opacity 0.15s ease, text-decoration-color 0.15s ease;
  }
  .footer-link:hover,
  .footer-link:focus-visible {
    opacity: 1;
    text-decoration-color: currentColor;
  }

  .footer-heart {
    display: inline-block;
    color: #ef4444;
    transform: translateY(1px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .footer-heart {
      animation: footer-heartbeat 1.6s ease-in-out infinite;
    }
  }
  @keyframes footer-heartbeat {
    0%, 60%, 100% { transform: translateY(1px) scale(1); }
    20% { transform: translateY(1px) scale(1.18); }
    40% { transform: translateY(1px) scale(1.05); }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  function applyTheme(setting: string) {
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const isDark = setting === "dark" || (setting === "system" && prefersDark);
    const root = document.documentElement;
    root.classList.remove("dark", "light");
    if (isDark) {
      root.classList.add("dark");
    } else if (setting === "light") {
      root.classList.add("light");
    }
  }

  function updateButtons(active: string) {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".theme-btn")
    );
    const hasActive = buttons.some((b) => b.dataset.theme === active);
    buttons.forEach((btn) => {
      const isActive = btn.dataset.theme === active;
      btn.setAttribute("aria-checked", isActive ? "true" : "false");
      // Roving tabindex: only the checked radio (or first, as fallback) is tabbable.
      btn.tabIndex = isActive || (!hasActive && btn === buttons[0]) ? 0 : -1;
      if (isActive) {
        btn.setAttribute("data-active", "");
      } else {
        btn.removeAttribute("data-active");
      }
    });
  }

  // ClientRouter replaces the footer DOM on every navigation, so we need to
  // re-bind listeners after each swap. `astro:page-load` fires on the initial
  // load and after every view-transition swap.
  function bindThemeButtons() {
    const themeButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".theme-btn")
    );

    function selectTheme(btn: HTMLButtonElement, focus = false) {
      const theme = btn.dataset.theme!;
      localStorage.setItem("theme", theme);
      applyTheme(theme);
      updateButtons(theme);
      if (focus) btn.focus();
    }

    themeButtons.forEach((btn, idx) => {
      btn.addEventListener("click", () => selectTheme(btn));

      btn.addEventListener("keydown", (e) => {
        let nextIdx: number | null = null;
        switch (e.key) {
          case "ArrowRight":
          case "ArrowDown":
            nextIdx = (idx + 1) % themeButtons.length;
            break;
          case "ArrowLeft":
          case "ArrowUp":
            nextIdx = (idx - 1 + themeButtons.length) % themeButtons.length;
            break;
          case "Home":
            nextIdx = 0;
            break;
          case "End":
            nextIdx = themeButtons.length - 1;
            break;
        }
        if (nextIdx !== null) {
          e.preventDefault();
          selectTheme(themeButtons[nextIdx], true);
        }
      });
    });

    const saved = localStorage.getItem("theme") || "system";
    applyTheme(saved);
    updateButtons(saved);
  }

  bindThemeButtons();
  document.addEventListener("astro:page-load", bindThemeButtons);

  // OS-level scheme changes only need to be wired once per browsing session.
  if (!(window as any).__themeOsListenerBound) {
    (window as any).__themeOsListenerBound = true;
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
      const current = localStorage.getItem("theme") || "system";
      if (current === "system") {
        applyTheme("system");
      }
    });
  }
</script>
