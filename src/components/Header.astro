---
---

<header
  class="sticky top-0 z-50 backdrop-blur-md bg-surface/80 border-b border-border/10"
>
  <nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="font-display font-bold text-lg tracking-tight text-primary/90 hover:text-accent transition-colors">
      Brandon Moore
    </a>

    <!-- Nav Links -->
    <div class="flex items-center gap-8">
      <!-- Work Dropdown -->
      <div class="relative group">
        <button
          class="text-sm font-medium text-primary/60 hover:text-primary/90 transition-colors flex items-center gap-1"
          aria-haspopup="true"
        >
          Work
          <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown -->
        <div
          class="absolute top-full right-0 mt-2 w-64 py-2 bg-raised rounded-xl shadow-lg border border-border/10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0"
        >
          <a
            href="/projects/get-app"
            class="block px-4 py-2.5 text-sm text-primary/70 hover:bg-border/5 hover:text-accent transition-colors"
          >
            <span class="font-medium block">GET App Redesign</span>
            <span class="text-xs text-primary/50">All-in-one app for college students</span>
          </a>
          <a
            href="/projects/aqua-design-system"
            class="block px-4 py-2.5 text-sm text-primary/70 hover:bg-border/5 hover:text-accent transition-colors"
          >
            <span class="font-medium block">Aqua Design System</span>
            <span class="text-xs text-primary/50">First design system for two companies</span>
          </a>
          <a
            href="/projects/patient-app"
            class="block px-4 py-2.5 text-sm text-primary/70 hover:bg-border/5 hover:text-accent transition-colors"
          >
            <span class="font-medium block">Patient App</span>
            <span class="text-xs text-primary/50">Food ordering for healthcare</span>
          </a>
        </div>
      </div>

      <a
        href="/about"
        class="text-sm font-medium text-primary/60 hover:text-primary/90 transition-colors"
      >
        About
      </a>
    </div>
  </nav>
</header>
