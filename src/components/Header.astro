---
import LiquidLogo from "./LiquidLogo.astro";
---

<header
  id="site-header"
  class="absolute top-0 left-0 right-0 z-50"
>
  <nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between" aria-label="Primary">
    <!-- Brand: liquid logo + wordmark, single link to home.
         `data-astro-reload` opts this link out of ClientRouter so the drain
         + droplet animation has time to play visibly (view-transition
         snapshots paint above real DOM and would hide it otherwise). -->
    <a
      href="/"
      class="brand-link inline-flex items-center gap-2.5 font-display font-medium text-lg tracking-tight text-primary/90 transition-colors"
      data-brand-trigger
      data-astro-reload
    >
      <LiquidLogo />
      <span>Brandon Moore</span>
    </a>

    <!-- Nav Links -->
    <ul class="flex items-center gap-1 list-none m-0 p-0">
      <!-- Work Disclosure -->
      <li class="relative" data-disclosure>
        <button
          type="button"
          class="nav-link text-sm font-medium text-primary/70 hover:text-primary/90 transition-colors flex items-center gap-1 px-3 py-2 rounded-xl"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="work-menu"
          data-disclosure-trigger
        >
          Work
          <svg
            class="w-3.5 h-3.5 transition-transform duration-300"
            data-disclosure-chevron
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown -->
        <div
          id="work-menu"
          class="dropdown-menu absolute top-full right-0 pt-1 w-max max-w-xs"
          data-disclosure-panel
          inert
        >
          <ul class="p-2 bg-raised rounded-2xl shadow-xl border border-border/10 list-none m-0">
            <li>
              <a
                href="/projects/get-app"
                class="block px-4 py-2.5 rounded-xl text-sm font-medium text-primary/80 hover:bg-border/5 hover:text-primary/90 transition-colors whitespace-nowrap"
              >
                GET App Redesign
              </a>
            </li>
            <li>
              <a
                href="/projects/aqua-design-system"
                class="block px-4 py-2.5 rounded-xl text-sm font-medium text-primary/80 hover:bg-border/5 hover:text-primary/90 transition-colors whitespace-nowrap"
              >
                Aqua Design System
              </a>
            </li>
            <li>
              <a
                href="/projects/patient-app"
                class="block px-4 py-2.5 rounded-xl text-sm font-medium text-primary/80 hover:bg-border/5 hover:text-primary/90 transition-colors whitespace-nowrap"
              >
                Patient App
              </a>
            </li>
          </ul>
        </div>
      </li>

      <li>
        <a
          href="/about"
          class="nav-link text-sm font-medium text-primary/70 hover:text-primary/90 transition-colors px-3 py-2 rounded-xl inline-flex items-center"
        >
          About
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  #site-header {
    will-change: transform;
    transition: background-color 250ms ease, border-color 250ms ease;
    background-color: transparent;
    border-bottom: 1px solid transparent;
    backdrop-filter: none;
  }

  /* Only show frosted bg + border when pinned (i.e., re-appearing on scroll up) */
  #site-header.is-pinned {
    position: fixed;
    transform: translateY(-100%);
    background-color: color-mix(in srgb, var(--color-surface) 80%, transparent);
    border-bottom-color: color-mix(in srgb, var(--color-border) 10%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  #site-header.is-pinned.is-visible {
    transform: translateY(0);
    transition:
      transform 320ms cubic-bezier(0.165, 0.84, 0.44, 1),
      background-color 250ms ease,
      border-color 250ms ease;
  }

  /* Disclosure panel: visually hidden by default; JS controls .is-open and the
     `inert` attribute (which blocks focus + interaction + hides from AT). */
  .dropdown-menu {
    transform: translateY(-4px) scale(0.96);
    transform-origin: top right;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 200ms cubic-bezier(0.165, 0.84, 0.44, 1),
      transform 240ms cubic-bezier(0.345, 0.115, 0.135, 1.42),
      visibility 240ms;
  }
  [data-disclosure].is-open .dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  [data-disclosure].is-open [data-disclosure-chevron] {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-menu {
      transition: none;
    }
  }

  /* ── Nav link hover pill ─────────────────────────────────────────────────
     Pill background expands from the center on hover/focus/open. Subtle —
     matches the rest of the surface treatments and doesn't compete with the
     liquid logo for attention. */
  .nav-link {
    position: relative;
    isolation: isolate;
  }
  .nav-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: color-mix(in srgb, var(--color-border) 12%, transparent);
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 220ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 280ms cubic-bezier(0.34, 1.4, 0.64, 1);
    z-index: -1;
    pointer-events: none;
  }
  .nav-link:hover::before,
  .nav-link:focus-visible::before,
  [data-disclosure].is-open .nav-link::before {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::before {
      transition: opacity 200ms ease;
      transform: none;
    }
  }
</style>

<script>
  // Header is re-rendered on every ClientRouter navigation, so the disclosure
  // listeners need to re-bind on each `astro:page-load`. The scroll listener
  // attaches to `window` and only needs to bind once per session.
  function bindDisclosures() {
    document.querySelectorAll<HTMLElement>("[data-disclosure]").forEach((root) => {
      if ((root as any).__disclosureBound) return;
      (root as any).__disclosureBound = true;

      const trigger = root.querySelector<HTMLButtonElement>(
        "[data-disclosure-trigger]"
      );
      const panel = root.querySelector<HTMLElement>("[data-disclosure-panel]");
      if (!trigger || !panel) return;

      let hoverCloseTimer: number | undefined;

      const setOpen = (open: boolean) => {
        root.classList.toggle("is-open", open);
        trigger.setAttribute("aria-expanded", String(open));
        if (open) {
          panel.removeAttribute("inert");
        } else {
          panel.setAttribute("inert", "");
        }
      };

      // Click toggles
      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        setOpen(trigger.getAttribute("aria-expanded") !== "true");
      });

      // Hover opens (mouse convenience). Small delay on close so users can move
      // the cursor between trigger and panel without flicker.
      const onEnter = () => {
        if (hoverCloseTimer) {
          clearTimeout(hoverCloseTimer);
          hoverCloseTimer = undefined;
        }
        setOpen(true);
      };
      const onLeave = () => {
        hoverCloseTimer = window.setTimeout(() => {
          if (!root.contains(document.activeElement)) setOpen(false);
        }, 120);
      };
      root.addEventListener("pointerenter", onEnter);
      root.addEventListener("pointerleave", onLeave);

      // Escape closes + returns focus
      root.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && root.classList.contains("is-open")) {
          setOpen(false);
          trigger.focus();
        }
      });

      // Focus leaving the disclosure subtree closes (keyboard tabbing past)
      root.addEventListener("focusout", () => {
        setTimeout(() => {
          if (!root.contains(document.activeElement)) setOpen(false);
        }, 0);
      });
    });
  }

  // Click-outside is a single document-level listener; bind once per session.
  if (!(window as any).__headerDocClickBound) {
    (window as any).__headerDocClickBound = true;
    document.addEventListener("click", (e) => {
      document.querySelectorAll<HTMLElement>("[data-disclosure]").forEach((root) => {
        if (!root.contains(e.target as Node) && root.classList.contains("is-open")) {
          const trigger = root.querySelector<HTMLButtonElement>(
            "[data-disclosure-trigger]"
          );
          const panel = root.querySelector<HTMLElement>("[data-disclosure-panel]");
          root.classList.remove("is-open");
          trigger?.setAttribute("aria-expanded", "false");
          panel?.setAttribute("inert", "");
        }
      });
    });
  }

  // ── Pin-on-scroll-up behavior ────────────────────────────────────────────
  if (!(window as any).__headerScrollBound) {
    (window as any).__headerScrollBound = true;

    let lastY = window.scrollY;
    let accumulated = 0;
    let ticking = false;
    const threshold = 60;

    function update() {
      const header = document.getElementById("site-header");
      if (!header) {
        ticking = false;
        return;
      }
      const y = window.scrollY;
      const delta = y - lastY;

      if (y <= 0) {
        header.classList.remove("is-pinned", "is-visible");
        accumulated = 0;
        lastY = y;
        ticking = false;
        return;
      }

      if (Math.sign(delta) !== Math.sign(accumulated)) {
        accumulated = delta;
      } else {
        accumulated += delta;
      }

      if (accumulated < -threshold) {
        if (!header.classList.contains("is-pinned")) {
          header.classList.add("is-pinned");
          void header.offsetHeight;
        }
        header.classList.add("is-visible");
      } else if (accumulated > threshold && header.classList.contains("is-pinned")) {
        header.classList.remove("is-pinned", "is-visible");
      }

      lastY = y;
      ticking = false;
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
  }

  bindDisclosures();
  document.addEventListener("astro:page-load", bindDisclosures);
</script>
