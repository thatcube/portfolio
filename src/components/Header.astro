---
import LiquidLogo from "./LiquidLogo.astro";
---

<header id="site-header" class="absolute top-0 left-0 right-0 z-50">
  <nav
    class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between"
    aria-label="Primary"
  >
    <!-- Brand: liquid logo + wordmark, single link to home.
         Stays on SPA nav so the LiquidLogo SVG persists across navigation
         (transition:persist on the SVG wrapper). The drain/spring animation
         continues seamlessly across the page swap — no full reload, no
         repaint flash. -->
    <a
      href="/"
      class="brand-link inline-flex items-center gap-2.5 font-display font-bold text-lg tracking-tight text-primary/90 transition-colors"
      data-brand-trigger
    >
      <LiquidLogo />
      <span>Brandon Moore</span>
    </a>

    <!-- Nav Links -->
    <ul class="flex items-center gap-1 list-none m-0 p-0">
      <li>
        <a
          href="/about"
          class="nav-link text-sm font-medium text-primary/70 hover:text-primary/90 transition-colors px-3 py-2 rounded-xl inline-flex items-center"
        >
          About
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  #site-header {
    will-change: transform;
    transition:
      background-color 250ms ease,
      border-color 250ms ease;
    background-color: transparent;
    border-bottom: 1px solid transparent;
    backdrop-filter: none;
  }

  /* Only show frosted bg + border when pinned (i.e., re-appearing on scroll up) */
  #site-header.is-pinned {
    position: fixed;
    transform: translateY(-100%);
    background-color: color-mix(in srgb, var(--color-surface) 80%, transparent);
    border-bottom-color: color-mix(
      in srgb,
      var(--color-border) 10%,
      transparent
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  #site-header.is-pinned.is-visible {
    transform: translateY(0);
    transition:
      transform 320ms cubic-bezier(0.165, 0.84, 0.44, 1),
      background-color 250ms ease,
      border-color 250ms ease;
  }

  /* ── Nav link hover pill ───────────────────────────────────────────
     Same family as the theme-toggle indicator: a soft "liquid" blob that
     squishes in on hover and counter-squishes on click. Text stays put —
     only the background moves so it reads as a watery surface settling
     under the cursor. */
  .nav-link {
    position: relative;
    isolation: isolate;
    transition: color 200ms ease;
  }
  .nav-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: color-mix(in srgb, var(--color-border) 14%, transparent);
    opacity: 0;
    /* Start squashed wider-than-tall so the entry reads as a liquid blob
       expanding into shape, not a uniform fade-in. */
    transform: scale(0.7, 0.5);
    transition:
      opacity 220ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 360ms cubic-bezier(0.34, 1.55, 0.5, 1);
    z-index: -1;
    pointer-events: none;
  }
  .nav-link:hover::before,
  .nav-link:focus-visible::before {
    opacity: 1;
    transform: scale(1, 1);
  }
  .nav-link:active::before {
    /* Counter-squish on click — like the theme indicator's slosh. */
    transform: scale(1.04, 0.86);
    transition-duration: 140ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::before {
      transition: opacity 200ms ease;
      transform: none !important;
    }
  }
</style>

<script>
  // ── Pin-on-scroll-up behavior ────────────────────────────────────────────
  if (!(window as any).__headerScrollBound) {
    (window as any).__headerScrollBound = true;

    let lastY = window.scrollY;
    let accumulated = 0;
    let ticking = false;
    const threshold = 60;

    function update() {
      const header = document.getElementById("site-header");
      if (!header) {
        ticking = false;
        return;
      }
      const y = window.scrollY;
      const delta = y - lastY;

      if (y <= 0) {
        header.classList.remove("is-pinned", "is-visible");
        accumulated = 0;
        lastY = y;
        ticking = false;
        return;
      }

      if (Math.sign(delta) !== Math.sign(accumulated)) {
        accumulated = delta;
      } else {
        accumulated += delta;
      }

      if (accumulated < -threshold) {
        if (!header.classList.contains("is-pinned")) {
          header.classList.add("is-pinned");
          void header.offsetHeight;
        }
        header.classList.add("is-visible");
      } else if (
        accumulated > threshold &&
        header.classList.contains("is-pinned")
      ) {
        header.classList.remove("is-pinned", "is-visible");
      }

      lastY = y;
      ticking = false;
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
