---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="not-prose -mx-6 sm:-mx-12 lg:-mx-24 my-12">
  <Image
    src={src}
    alt={alt}
    widths={[800, 1200, 1920]}
    sizes="100vw"
    class="w-full rounded-xl"
  />
  {caption && (
    <figcaption class="text-center text-sm text-primary/50 mt-3 px-6">
      {caption}
    </figcaption>
  )}
</figure>
